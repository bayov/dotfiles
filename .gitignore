# Jujutsu VCS
.jj

# Vim
*~
*.swp
*.swo

# Backup files
*.bk
*.bak
*.old

# link.py state (machine-local)
.links.toml

# Machine profile marker (consumed by pybayov.machine)
.machine-profile

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
.env.*
!.env.example
!.env.test

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# Generated by cargo-run-bin
.bin/

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Compiled Python
__pycache__
*.pyc

# Python venv
.venv/
venv/
wsl_venv/

# Node.js
node_modules/
.pnpm-store/

# SvelteKit / Vite build output
.output/
.svelte-kit/
build/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Beancount cache
*.picklecache

# JetBrains CSV-Editor plugin cache
.idea/csv-editor.xml

# Playwright MCP output
.playwright-mcp/

# Claude skills synced from claude.ai, and skills it deleted (machine-local)
home/.agents/skills/synced/
home/.agents/skills/.trash/
