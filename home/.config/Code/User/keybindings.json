[
    //--------------------------------------------------------------------------
    // Command Palette & Quick Open
    //--------------------------------------------------------------------------

    { "command": "-workbench.action.showCommands", "key": "f1" },
    { "command": "-workbench.action.showCommands", "key": "ctrl+shift+p" },
    { "command": "-workbench.action.showCommands", "key": "shift+ctrl+a" },
    { "command": "workbench.action.showCommands", "key": "alt+a" },
    { "command": "workbench.action.showCommands", "key": "shift shift" },

    { "command": "-workbench.action.quickOpen", "key": "ctrl+p" },
    { "command": "-workbench.action.quickOpen", "key": "ctrl+r" },
    { "command": "-workbench.action.quickOpen", "key": "shift+ctrl+n" },
    { "command": "workbench.action.quickOpen", "key": "alt+f" },

    { "command": "-workbench.action.showAllSymbols", "key": "ctrl+t" },
    { "command": "-workbench.action.showAllSymbols", "key": "ctrl+n" },
    { "command": "workbench.action.showAllSymbols", "key": "alt+t" },

    { "command": "workbench.action.gotoLine", "key": "ctrl+g" },

    { "command": "-workbench.action.gotoSymbol", "key": "ctrl+shift+o" },
    { "command": "workbench.action.gotoSymbol", "key": "ctrl+f12", "when": "editorTextFocus" },
    { "command": "workbench.action.gotoSymbol", "key": "shift+ctrl+alt+n", "when": "editorTextFocus" },

    { "command": "-workbench.action.quickOpenNavigateNext", "key": "" },
    { "command": "workbench.action.quickOpenNavigateNext", "key": "ctrl+tab", "when": "inQuickOpen" },

    //--------------------------------------------------------------------------
    // File & Editor Management
    //--------------------------------------------------------------------------

    { "command": "-workbench.action.files.saveAll", "key": "ctrl+k s" },
    { "command": "workbench.action.files.saveAll", "key": "ctrl+s" },

    { "command": "-workbench.action.closeActiveEditor", "key": "ctrl+w" },
    { "command": "workbench.action.closeActiveEditor", "key": "ctrl+f4" },
    { "command": "workbench.action.closeActiveEditor", "key": "alt+x" },

    { "command": "-workbench.action.closeAllEditors", "key": "ctrl+k ctrl+w" },
    { "command": "workbench.action.closeAllEditors", "key": "alt+s x" },

    { "command": "workbench.action.closeOtherEditors", "key": "alt+s d" },

    { "command": "-workbench.action.reopenClosedEditor", "key": "ctrl+shift+t" },
    { "command": "workbench.action.reopenClosedEditor", "key": "shift+alt+x" },

    { "command": "-workbench.action.openRecent", "key": "ctrl+e" },
    { "command": "workbench.action.openRecent", "key": "alt+w", "when": "!inQuickOpen" },

    { "command": "-workbench.action.openPreviousEditorFromHistory", "key": "ctrl+e" },
    { "command": "workbench.action.openPreviousEditorFromHistory", "key": "shift+ctrl+h", "when": "inQuickOpen" },

    { "command": "-workbench.action.files.showOpenedFileInNewWindow", "key": "ctrl+k o" },
    { "command": "workbench.action.files.showOpenedFileInNewWindow", "key": "shift+f4", "when": "emptyWorkspaceSupport" },

    { "command": "-workbench.action.files.newUntitledFile", "key": "ctrl+n" },
    {
        "command": "-workbench.action.files.newUntitledFile",
        "key": "alt+insert",
        "when": "!editorTextFocus || editorTextFocus && !editorHasCodeActionsProvider"
    },
    { "command": "explorer.newFile", "key": "alt+insert", "when": "explorerViewletFocus" },
    { "command": "explorer.newFolder", "key": "shift+alt+insert", "when": "explorerViewletFocus" },

{ "command": "-copyFilePath", "key": "shift+alt+c" },
    { "command": "-copyFilePath", "key": "ctrl+shift+c", "when": "!editorFocus && !terminalFocus" },
    { "command": "copyFilePath", "key": "ctrl+k ctrl+shift+c", "when": "!editorFocus && !terminalFocus" },

    { "command": "-workbench.action.terminal.openNativeConsole", "key": "ctrl+shift+c", "when": "!terminalFocus" },
    { "command": "-copyRelativeFilePath", "key": "ctrl+k ctrl+shift+c", "when": "editorFocus" },
    { "command": "-copyRelativeFilePath", "key": "ctrl+k ctrl+shift+c", "when": "!editorFocus" },
    { "command": "copyRelativeFilePath", "key": "ctrl+shift+c", "when": "editorFocus || explorerViewletFocus" },

    { "command": "-editor.action.clipboardCopyAction", "key": "ctrl+insert" },

    //--------------------------------------------------------------------------
    // Settings & Keybindings
    //--------------------------------------------------------------------------

    { "command": "-workbench.action.openGlobalSettings", "key": "" },
    { "command": "-workbench.action.openGlobalSettings", "key": "ctrl+alt+s" },
    { "command": "workbench.action.openGlobalSettings", "key": "alt+'" },

    { "command": "-workbench.action.openGlobalKeybindings", "key": "ctrl+k ctrl+s" },
    { "command": "workbench.action.openGlobalKeybindings", "key": "alt+;" },
    { "command": "workbench.action.openGlobalKeybindingsFile", "key": "shift+alt+;" },

    { "command": "workbench.action.openSettingsJson", "key": "shift+alt+'" },

    //--------------------------------------------------------------------------
    // Cursor Movement & Navigation
    //--------------------------------------------------------------------------

    { "command": "-cursorLineEnd", "key": "" },
    { "command": "cursorLineEnd", "key": "end", "when": "textInputFocus" },

    { "command": "-cursorLineEndSelect", "key": "" },
    { "command": "cursorLineEndSelect", "key": "shift+end", "when": "textInputFocus" },

    { "command": "-cursorLineStart", "key": "" },
    { "command": "cursorLineStart", "key": "home", "when": "textInputFocus" },

    { "command": "-cursorLineStartSelect", "key": "" },
    { "command": "cursorLineStartSelect", "key": "shift+home", "when": "textInputFocus" },

    { "command": "-cursorBottomSelect", "key": "ctrl+shift+end" },
    { "command": "cursorBottomSelect", "key": "shift+ctrl+pagedown", "when": "textInputFocus" },
    { "command": "cursorBottom", "key": "ctrl+pagedown", "when": "textInputFocus" },
    { "command": "cursorBottom", "key": "alt+end", "when": "textInputFocus" },

    { "command": "-cursorTopSelect", "key": "ctrl+shift+home" },
    { "command": "cursorTopSelect", "key": "shift+ctrl+pageup", "when": "textInputFocus" },
    { "command": "cursorTop", "key": "ctrl+pageup", "when": "textInputFocus" },
    { "command": "cursorTop", "key": "alt+home", "when": "textInputFocus" },

    { "command": "-cursorWordRightSelect", "key": "ctrl+shift+right" },
    {
        "command": "cursorWordRight",
        "key": "ctrl+right",
        "when": "editorTextFocus && !inlineSuggestionVisible && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },
    {
        "command": "cursorWordRightSelect",
        "key": "shift+ctrl+right",
        "when": "editorTextFocus && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },

    { "command": "-cursorWordLeftSelect", "key": "ctrl+shift+left" },
    {
        "command": "cursorWordLeft",
        "key": "ctrl+left",
        "when": "editorTextFocus && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },
    {
        "command": "cursorWordLeftSelect",
        "key": "shift+ctrl+left",
        "when": "editorTextFocus && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },

    { "command": "-workbench.action.navigateBack", "key": "alt+left" },
    { "command": "workbench.action.navigateBack", "key": "ctrl+alt+left", "when": "canNavigateBack" },

    { "command": "-workbench.action.navigateForward", "key": "alt+right" },
    { "command": "workbench.action.navigateForward", "key": "ctrl+alt+right", "when": "canNavigateForward" },

    { "command": "-workbench.action.navigateToLastEditLocation", "key": "ctrl+k ctrl+q" },
    { "command": "workbench.action.navigateToLastEditLocation", "key": "shift+ctrl+backspace" },

    // Free ctrl+u from dart/java before using it for cursorUndo
    { "command": "-dart.goToSuper", "key": "ctrl+u", "when": "editorTextFocus && editorLangId == 'dart'" },
    {
        "command": "-java.action.navigateToSuperImplementation",
        "key": "ctrl+u",
        "when": "editorHasImplementationProvider && editorTextFocus && javaLSReady && !isInEmbeddedEditor && editorLangId == 'java'"
    },
    {
        "command": "-java.action.navigateToSuperImplementation",
        "key": "ctrl+u",
        "when": "editorTextFocus && java:serverMode == 'Standard'"
    },
    { "command": "-cursorUndo", "key": "ctrl+u" },
    { "command": "-cursorUndo", "key": "shift+alt+j" },
    { "command": "cursorUndo", "key": "shift+alt+pageup", "when": "textInputFocus" },

    //--------------------------------------------------------------------------
    // Scrolling
    //--------------------------------------------------------------------------

    {
        "command": "cursorMove",
        "key": "pagedown",
        "when": "textInputFocus",
        "args": { "to": "down", "by": "wrappedLine", "value": 25 }
    },
    {
        "command": "cursorMove",
        "key": "pageup",
        "when": "textInputFocus",
        "args": { "to": "up", "by": "wrappedLine", "value": 25 }
    },
    {
        "command": "cursorMove",
        "key": "shift+pagedown",
        "when": "textInputFocus",
        "args": { "to": "down", "by": "wrappedLine", "value": 25, "select": true }
    },
    {
        "command": "cursorMove",
        "key": "shift+pageup",
        "when": "textInputFocus",
        "args": { "to": "up", "by": "wrappedLine", "value": 25, "select": true }
    },
    {
        "command": "editorScroll",
        "key": "alt+pagedown",
        "when": "textInputFocus",
        "args": { "to": "down", "by": "wrappedLine", "value": 25 }
    },
    {
        "command": "editorScroll",
        "key": "alt+pageup",
        "when": "textInputFocus",
        "args": { "to": "up", "by": "wrappedLine", "value": 25 }
    },
    {
        "command": "editorScroll",
        "key": "alt+down",
        "when": "textInputFocus",
        "args": { "to": "down", "by": "wrappedLine", "value": 2 }
    },
    {
        "command": "editorScroll",
        "key": "alt+up",
        "when": "textInputFocus",
        "args": { "to": "up", "by": "wrappedLine", "value": 2 }
    },

    //--------------------------------------------------------------------------
    // Editor Tabs & Groups
    //--------------------------------------------------------------------------

    { "command": "-workbench.action.nextEditor", "key": "ctrl+pagedown" },
    { "command": "workbench.action.nextEditor", "key": "alt+right" },

    { "command": "-workbench.action.previousEditor", "key": "ctrl+pageup" },
    { "command": "workbench.action.previousEditor", "key": "alt+left" },

    { "command": "-workbench.action.moveEditorLeftInGroup", "key": "ctrl+shift+pageup" },
    { "command": "-editor.action.inlineSuggest.showPrevious", "key": "alt+[", "when": "inlineSuggestionVisible && !editorReadonly" },
    { "command": "-editor.action.accessibleViewPrevious", "key": "alt+[", "when": "accessibleViewIsShown && accessibleViewSupportsNavigation" },
    { "command": "workbench.action.moveEditorLeftInGroup", "key": "alt+[" },

    { "command": "-workbench.action.moveEditorRightInGroup", "key": "ctrl+shift+pagedown" },
    { "command": "-editor.action.accessibleViewNext", "key": "alt+]", "when": "accessibleViewIsShown && accessibleViewSupportsNavigation" },
    { "command": "-editor.action.inlineSuggest.showNext", "key": "alt+]", "when": "inlineSuggestionVisible && !editorReadonly" },
    { "command": "workbench.action.moveEditorRightInGroup", "key": "alt+]" },

    { "command": "workbench.action.moveEditorToLeftGroup", "key": "shift+alt+[" },
    { "command": "workbench.action.moveEditorToRightGroup", "key": "shift+alt+]" },

    { "command": "-editor.action.smartSelect.expand", "key": "shift+alt+right", "when": "editorTextFocus" },
    { "command": "-workbench.action.focusRightGroup", "key": "ctrl+k ctrl+right" },
    { "command": "workbench.action.focusRightGroup", "key": "shift+alt+right" },

    { "command": "-workbench.action.focusLeftGroup", "key": "ctrl+k ctrl+left" },
    { "command": "workbench.action.focusLeftGroup", "key": "shift+alt+left" },

    { "command": "workbench.action.focusActiveEditorGroup", "key": "alt+e" },

    { "command": "-keybindings.editor.toggleSortByPrecedence", "key": "alt+p", "when": "inKeybindings" },
    { "command": "-toggleSearchPreserveCase", "key": "alt+p", "when": "searchViewletFocus" },
    { "command": "-togglePreserveCase", "key": "alt+p", "when": "editorFocus" },
    { "command": "-workbench.action.pinEditor", "key": "ctrl+k shift+enter", "when": "!activeEditorIsPinned" },
    { "command": "workbench.action.pinEditor", "key": "alt+p", "when": "!activeEditorIsPinned" },

    { "command": "-workbench.action.unpinEditor", "key": "ctrl+k shift+enter", "when": "activeEditorIsPinned" },
    { "command": "workbench.action.unpinEditor", "key": "alt+p", "when": "activeEditorIsPinned" },

    { "command": "-workbench.action.closeEditorsInGroup", "key": "ctrl+k w" },
    { "command": "-workbench.action.closeAllGroups", "key": "ctrl+k ctrl+shift+w" },

    { "command": "workbench.action.toggleEditorWidths", "key": "alt+s f" },
    { "command": "workbench.action.evenEditorWidths", "key": "alt+s s" },

    //--------------------------------------------------------------------------
    // Text Editing
    //--------------------------------------------------------------------------

    { "command": "undo", "key": "ctrl+z" },
    { "command": "undo", "key": "alt+backspace" },

    { "command": "-redo", "key": "ctrl+shift+z" },
    { "command": "-redo", "key": "ctrl+y" },
    { "command": "redo", "key": "shift+ctrl+z" },
    { "command": "redo", "key": "shift+alt+backspace" },

    { "command": "editor.action.clipboardCutAction", "key": "ctrl+x", "when": "editorTextFocus && !editorReadonly" },
    { "command": "editor.action.clipboardCutAction", "key": "shift+delete", "when": "editorTextFocus && !editorReadonly" },

    { "command": "-editor.action.clipboardPasteAction", "key": "shift+insert" },
    { "command": "editor.action.clipboardPasteAction", "key": "ctrl+v", "when": "editorFocus" },
    { "command": "-editor.action.clipboardPasteAction", "key": "ctrl+v" },

    { "command": "-editor.action.deleteLines", "key": "ctrl+shift+k" },
    { "command": "editor.action.deleteLines", "key": "ctrl+y", "when": "textInputFocus && !editorReadonly" },

    {
        "command": "deleteWordRight",
        "key": "ctrl+delete",
        "when": "textInputFocus && !editorReadonly && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },
    {
        "command": "deleteWordLeft",
        "key": "ctrl+backspace",
        "when": "textInputFocus && !editorReadonly && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },

    { "command": "-editor.action.joinLines", "key": "" },
    { "command": "-editor.action.joinLines", "key": "shift+ctrl+j" },
    { "command": "editor.action.joinLines", "key": "ctrl+alt+x", "when": "editorTextFocus && !editorReadonly" },

    { "command": "-editor.action.copyLinesDownAction", "key": "shift+alt+down" },
    { "command": "-editor.action.copyLinesDownAction", "key": "ctrl+d" },
    {
        "command": "editor.action.copyLinesDownAction",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus && !editorReadonly && !editorHasSelection"
    },

    { "command": "-editor.action.moveLinesDownAction", "key": "alt+down" },
    { "command": "-editor.action.moveLinesDownAction", "key": "shift+alt+down" },
    { "command": "editor.action.moveLinesDownAction", "key": "shift+ctrl+down", "when": "editorTextFocus && !editorReadonly" },

    { "command": "-editor.action.moveLinesUpAction", "key": "alt+up" },
    { "command": "-editor.action.moveLinesUpAction", "key": "shift+alt+up" },
    { "command": "editor.action.moveLinesUpAction", "key": "shift+ctrl+up", "when": "editorTextFocus && !editorReadonly" },

    { "command": "-lineBreakInsert", "key": "" },
    { "command": "lineBreakInsert", "key": "ctrl+enter", "when": "textInputFocus && !editorReadonly" },

    { "command": "-editor.action.insertLineAfter", "key": "ctrl+enter" },
    { "command": "editor.action.insertLineAfter", "key": "shift+enter", "when": "editorTextFocus && !editorReadonly && !notebookEditorFocused" },
    { "command": "editor.action.insertLineAfter", "key": "shift+enter", "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible" },

    { "command": "-editor.action.insertLineBefore", "key": "ctrl+shift+enter" },
    { "command": "editor.action.insertLineBefore", "key": "ctrl+alt+enter", "when": "editorTextFocus && !editorReadonly" },

    { "command": "-editor.action.toggleColumnSelection", "key": "" },
    { "command": "-editor.action.toggleColumnSelection", "key": "shift+alt+insert" },
    { "command": "editor.action.toggleColumnSelection", "key": "shift+insert" },

    { "command": "-editor.action.refactor", "key": "ctrl+shift+alt+t", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly" },
    { "command": "-editor.action.refactor", "key": "ctrl+shift+r", "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly" },
    { "command": "-editor.action.toggleWordWrap", "key": "alt+z" },
    { "command": "editor.action.refactor", "key": "alt+z", "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly" },

    { "command": "-editor.action.sourceAction", "key": "alt+insert", "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly" },

    //--------------------------------------------------------------------------
    // Multi-Cursor & Selection
    //--------------------------------------------------------------------------

    { "command": "-editor.action.smartSelect.grow", "key": "" },
    { "command": "editor.action.smartSelect.grow", "key": "ctrl+w", "when": "editorTextFocus" },

    { "command": "-editor.action.smartSelect.shrink", "key": "shift+alt+left" },
    { "command": "editor.action.smartSelect.shrink", "key": "shift+ctrl+w", "when": "editorTextFocus" },

    { "command": "-editor.action.selectHighlights", "key": "ctrl+shift+l" },
    { "command": "-editor.action.selectHighlights", "key": "shift+ctrl+alt+j" },
    { "command": "editor.action.selectHighlights", "key": "shift+alt+end", "when": "editorFocus" },

    { "command": "-editor.action.addSelectionToNextFindMatch", "key": "ctrl+d" },
    { "command": "-editor.action.addSelectionToNextFindMatch", "key": "alt+j" },
    { "command": "editor.action.addSelectionToNextFindMatch", "key": "shift+alt+pagedown", "when": "editorFocus" },

    { "command": "-editor.action.moveSelectionToNextFindMatch", "key": "ctrl+k ctrl+d", "when": "editorFocus" },
    { "command": "editor.action.moveSelectionToNextFindMatch", "key": "ctrl+alt+pagedown", "when": "editorFocus" },

    { "command": "editor.action.moveSelectionToPreviousFindMatch", "key": "ctrl+alt+pageup", "when": "editorFocus" },

    // Free shift+alt+up/down from copy/notebook actions before using for insertCursor
    { "command": "-editor.action.copyLinesUpAction", "key": "shift+alt+up", "when": "editorTextFocus && !editorReadonly" },
    { "command": "-notebook.cell.copyUp", "key": "shift+alt+up", "when": "notebookEditorFocused && !inputFocus" },
    { "command": "-editor.action.insertCursorAbove", "key": "shift+alt+up", "when": "editorTextFocus" },
    { "command": "editor.action.insertCursorAbove", "key": "ctrl+alt+up", "when": "editorTextFocus" },

    { "command": "-notebook.cell.copyDown", "key": "shift+alt+down", "when": "notebookEditorFocused && !inputFocus" },
    { "command": "-editor.action.insertCursorBelow", "key": "shift+alt+down", "when": "editorTextFocus" },
    { "command": "editor.action.insertCursorBelow", "key": "ctrl+alt+down", "when": "editorTextFocus" },

    { "command": "-cursorColumnSelectPageDown", "key": "ctrl+shift+alt+pagedown", "when": "textInputFocus" },
    { "command": "-cursorColumnSelectPageUp", "key": "ctrl+shift+alt+pageup", "when": "textInputFocus" },

    //--------------------------------------------------------------------------
    // Code Folding
    //--------------------------------------------------------------------------

    { "command": "-editor.foldAll", "key": "ctrl+k ctrl+0" },
    { "command": "-editor.foldAll", "key": "shift+ctrl+-" },
    { "command": "editor.foldAll", "key": "shift+ctrl+numpad_subtract", "when": "editorTextFocus && foldingEnabled" },

    { "command": "-editor.fold", "key": "ctrl+shift+[" },
    { "command": "-editor.fold", "key": "ctrl+-" },
    { "command": "editor.fold", "key": "ctrl+numpad_subtract", "when": "editorTextFocus && foldingEnabled" },

    { "command": "-editor.foldRecursively", "key": "ctrl+k ctrl+[" },
    { "command": "-editor.foldRecursively", "key": "ctrl+alt+-" },
    { "command": "editor.foldRecursively", "key": "ctrl+alt+numpad_subtract", "when": "editorTextFocus && foldingEnabled" },

    { "command": "-editor.unfoldAll", "key": "ctrl+k ctrl+j" },
    { "command": "-editor.unfoldAll", "key": "shift+ctrl+=" },
    { "command": "editor.unfoldAll", "key": "shift+ctrl+numpad_add", "when": "editorTextFocus && foldingEnabled" },

    { "command": "-editor.unfold", "key": "ctrl+shift+]" },
    { "command": "-editor.unfold", "key": "ctrl+=" },
    { "command": "editor.unfold", "key": "ctrl+numpad_add", "when": "editorTextFocus && foldingEnabled" },

    { "command": "-editor.unfoldRecursively", "key": "ctrl+k ctrl+]" },
    { "command": "-editor.unfoldRecursively", "key": "ctrl+alt+=" },
    { "command": "editor.unfoldRecursively", "key": "ctrl+alt+numpad_add", "when": "editorTextFocus && foldingEnabled" },

    //--------------------------------------------------------------------------
    // Find & Replace
    //--------------------------------------------------------------------------

    { "command": "-editor.action.nextMatchFindAction", "key": "f3" },
    { "command": "-editor.action.nextMatchFindAction", "key": "enter" },
    { "command": "-editor.action.nextMatchFindAction", "key": "ctrl+l" },
    { "command": "editor.action.nextMatchFindAction", "key": "enter", "when": "findWidgetVisible && findInputFocussed" },

    { "command": "-editor.action.previousMatchFindAction", "key": "shift+f3" },
    { "command": "-editor.action.previousMatchFindAction", "key": "shift+enter" },
    { "command": "-editor.action.previousMatchFindAction", "key": "shift+ctrl+l" },
    { "command": "editor.action.previousMatchFindAction", "key": "shift+enter", "when": "findWidgetVisible && findInputFocussed" },

    { "command": "-editor.action.startFindReplaceAction", "key": "ctrl+h" },
    { "command": "editor.action.startFindReplaceAction", "key": "ctrl+r", "when": "editorFocus || editorIsOpen" },

    { "command": "-workbench.action.findInFiles", "key": "ctrl+shift+f" },
    { "command": "workbench.action.findInFiles", "key": "shift+ctrl+f" },
    { "command": "workbench.action.findInFiles", "key": "shift+ctrl+f", "when": "!explorerResourceIsFolder || !filesExplorerFocus" },

    { "command": "-workbench.action.replaceInFiles", "key": "ctrl+shift+h" },
    { "command": "workbench.action.replaceInFiles", "key": "shift+ctrl+r" },

    { "command": "-workbench.action.compareEditor.nextChange", "key": "alt+f5" },
    { "command": "workbench.action.compareEditor.nextChange", "key": "f7", "when": "textCompareEditorVisible" },

    { "command": "-workbench.action.compareEditor.previousChange", "key": "shift+alt+f5" },
    { "command": "workbench.action.compareEditor.previousChange", "key": "shift+f7", "when": "textCompareEditorVisible" },

    // Rifler plugin (enhanced find/replace)
    { "command": "-rifler.open", "key": "ctrl+alt+f" },
    { "command": "rifler.open", "key": "ctrl+shift+f" },

    { "command": "-rifler.openReplace", "key": "ctrl+alt+r" },
    { "command": "rifler.openReplace", "key": "ctrl+shift+r" },

    //--------------------------------------------------------------------------
    // Search Options (Case / Regex / Whole Word)
    //--------------------------------------------------------------------------

    { "command": "-toggleFindCaseSensitive", "key": "alt+c", "when": "editorFocus" },
    { "command": "toggleFindCaseSensitive", "key": "alt+i", "when": "editorFocus" },

    { "command": "-toggleSearchCaseSensitive", "key": "alt+c", "when": "searchViewletFocus" },
    { "command": "toggleSearchCaseSensitive", "key": "alt+i", "when": "searchViewletFocus" },

    { "command": "-toggleSearchEditorCaseSensitive", "key": "alt+c", "when": "inSearchEditor && searchInputBoxFocus" },
    { "command": "toggleSearchEditorCaseSensitive", "key": "alt+i", "when": "inSearchEditor && searchInputBoxFocus" },

    {
        "command": "-workbench.action.terminal.toggleFindCaseSensitive",
        "key": "alt+c",
        "when": "terminalFindVisible && terminalHasBeenCreated || terminalFindVisible && terminalProcessSupported"
    },
    {
