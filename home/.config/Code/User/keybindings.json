        "command": "workbench.action.decreaseViewSize",
        "key": "ctrl+alt+numpad4",
        "when": "auxiliaryBarFocus && !inputFocus && !isAuxiliaryWindowFocusedContext && config.workbench.sideBar.location == 'right'"
    },
    {
        "command": "-workbench.action.increaseViewSize",
        "key": "ctrl+shift+alt+left",
        "when": "auxiliaryBarFocus && !inputFocus && !isAuxiliaryWindowFocusedContext && config.workbench.sideBar.location != 'right'"
    },
    {
        "command": "workbench.action.increaseViewSize",
        "key": "ctrl+alt+numpad4",
        "when": "auxiliaryBarFocus && !inputFocus && !isAuxiliaryWindowFocusedContext && config.workbench.sideBar.location != 'right'"
    },
    {
        "command": "-workbench.action.increaseViewSize",
        "key": "ctrl+shift+alt+left",
        "when": "sideBarFocus && !inputFocus && !isAuxiliaryWindowFocusedContext && config.workbench.sideBar.location == 'right'"
    },
    {
        "command": "workbench.action.increaseViewSize",
        "key": "ctrl+alt+numpad4",
        "when": "sideBarFocus && !inputFocus && !isAuxiliaryWindowFocusedContext && config.workbench.sideBar.location == 'right'"
    },

    { "command": "workbench.action.increaseViewWidth", "key": "ctrl+alt+numpad3", "when": "!auxiliaryBarFocus && !panelFocus && !sideBarFocus" },
    { "command": "workbench.action.decreaseViewWidth", "key": "ctrl+alt+numpad1", "when": "!sideBarFocus && !panelFocus && !auxiliaryBarFocus" },
    { "command": "workbench.action.decreaseViewHeight", "key": "ctrl+alt+numpad7", "when": "!sideBarFocus && !panelFocus && !auxiliaryBarFocus" },
    { "command": "workbench.action.increaseViewHeight", "key": "ctrl+alt+numpad9", "when": "!sideBarFocus && !panelFocus && !auxiliaryBarFocus" },

    // Font size / auto-fix unbinds (freeing shift+alt+.,)
    { "command": "-editor.action.fontZoomOut", "key": "shift+alt+,", "when": "editorTextFocus" },
    { "command": "-editor.action.autoFix", "key": "shift+alt+.", "when": "textInputFocus && !editorReadonly && supportedCodeAction =~ /(\\s|^)quickfix\\b/" },
    { "command": "-editor.action.fontZoomIn", "key": "shift+alt+.", "when": "editorTextFocus" },

    //--------------------------------------------------------------------------
    // Uncategorized (keybinding modifications done in UI will appear below)
    //--------------------------------------------------------------------------
]
