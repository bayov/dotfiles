{
    "title": "PC-style editing (Home/End, word-jump, Ctrl shortcuts)",
    "rules": [
        {
            "description": "Home -> beginning of line (Cmd+Left)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "home",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [
                        {
                            "key_code": "left_arrow",
                            "modifiers": ["left_command"]
                        }
                    ],
                    "conditions": [
                        {
                            "type": "frontmost_application_unless",
                            "bundle_identifiers": [
                                "^com\\.apple\\.Terminal$",
                                "^com\\.googlecode\\.iterm2$",
                                "^co\\.zeit\\.hyper$",
                                "^net\\.kovidgoyal\\.kitty$",
                                "^io\\.alacritty$",
                                "^com\\.github\\.wez\\.wezterm$",
                                "^dev\\.warp\\.Warp-Stable$",
                                "^org\\.gnu\\.Emacs$"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "description": "End -> end of line (Cmd+Right)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "end",
                        "modifiers": { "optional": ["any"] }
