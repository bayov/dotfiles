[user]
    name = Hagai Akibayov
    email = donbayov@gmail.com

[diff]
    colorMoved = default

[core]
    pager = delta
    autocrlf = input

[interactive]
    diffFilter = delta --color-only

[delta]
    features = bayov
    navigate = true  # use n and N to move between diff sections
    line-numbers = true
    hyperlinks = false
    tabs = 4

[include]
    path = ~/.config/delta/themes.gitconfig

# Per-machine overrides (e.g. work URL rewrites). Optional: git silently
# ignores includes whose path doesn't exist, so this is a no-op on machines
# without a local file.
[include]
    path = ~/.gitconfig.local

[merge]
    conflictStyle = zdiff3

[init]
	defaultBranch = main
