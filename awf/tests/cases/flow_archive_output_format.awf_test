# Test: awf flow archive --output-format with all 4 formats
# Uses the feature workflow. Archive mutates, so each format gets its own flow.

# --- Setup: feature workflow preamble ---

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a new feature from design through merge."
|
| [commands]
| test = "cargo test"
| lint = "cargo clippy -- -D warnings"
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| produces = ["design.md"]
| steps = [
|     { name = "write-design", type = "agent", prompt = "design.md" },
| ]
|
| [[stages]]
| name = "implement"
| description = "Write the code."
| requires = ["design.md"]
| steps = [
|     { name = "write-code", type = "agent", prompt = "implement.md" },
|     { name = "test", type = "command", command = "test" },
| ]
|
| [[stages]]
| name = "review"
| description = "Code review and integration."
| repeatable = true
| produces = ["changelog-entry.md"]
| steps = [
|     { name = "pre-review-test", type = "command", command = "test" },
|     { name = "do-review", type = "agent", prompt = "review.md" },
| ]
|
| [[stages]]
| name = "done"
| description = "Complete."

$ write_file .agents/workflows/feature/design.md
| # Design
| Write a design document.

$ write_file .agents/workflows/feature/implement.md
| # Implement
| Write the implementation.

$ write_file .agents/workflows/feature/review.md
| # Review
| Perform code review.

# --- Create separate flows for each format ---

$ awf flow new $FLOWS_DIR/fmt-arc-h --workflow feature
$ assert_stdout contains
| fmt-arc-h

$ awf flow new $FLOWS_DIR/fmt-arc-j --workflow feature
$ assert_stdout contains
| fmt-arc-j

$ awf flow new $FLOWS_DIR/fmt-arc-t --workflow feature
$ assert_stdout contains
| fmt-arc-t

$ awf flow new $FLOWS_DIR/fmt-arc-x --workflow feature
$ assert_stdout contains
| fmt-arc-x

# --- Human ---

$ awf flow archive --flow $FLOWS_DIR/fmt-arc-h --output-format human
$ assert_stdout contains
| Archived flow:

# --- JSON ---

$ awf flow archive --flow $FLOWS_DIR/fmt-arc-j --output-format json
$ assert_stdout json
| {"path": "<any_string>"}

# --- TOML ---

$ awf flow archive --flow $FLOWS_DIR/fmt-arc-t --output-format toml
$ assert_stdout toml
| {"path": "<any_string>"}

# --- XML ---

$ awf flow archive --flow $FLOWS_DIR/fmt-arc-x --output-format xml
$ assert_stdout xml
| {"path": "<any_string>"}
