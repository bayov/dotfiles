# Test flow step done with all 4 output formats

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a new feature from design through merge."
|
| [commands]
| test = "cargo test"
| lint = "cargo clippy -- -D warnings"
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| produces = ["design.md"]
| steps = [
|     { name = "write-design", type = "agent", prompt = "design.md" },
| ]
|
| [[stages]]
| name = "implement"
| description = "Write the code."
| requires = ["design.md"]
| steps = [
|     { name = "write-code", type = "agent", prompt = "implement.md" },
|     { name = "test", type = "command", command = "test" },
| ]
|
| [[stages]]
| name = "review"
| description = "Code review and integration."
| repeatable = true
| produces = ["changelog-entry.md"]
| steps = [
|     { name = "pre-review-test", type = "command", command = "test" },
|     { name = "do-review", type = "agent", prompt = "review.md" },
| ]
|
| [[stages]]
| name = "done"
| description = "Complete."

$ write_file .agents/workflows/feature/design.md
| # Design
| Write a design document.

$ write_file .agents/workflows/feature/implement.md
| # Implement
| Write the implementation.

$ write_file .agents/workflows/feature/review.md
| # Review
| Perform code review.

$ awf flow new $FLOWS_DIR/fmt-done-h --workflow feature
$ assert_stdout
| fmt-done-h

$ awf flow new $FLOWS_DIR/fmt-done-j --workflow feature
$ assert_stdout
| fmt-done-j

$ awf flow new $FLOWS_DIR/fmt-done-t --workflow feature
$ assert_stdout
| fmt-done-t

$ awf flow new $FLOWS_DIR/fmt-done-x --workflow feature
$ assert_stdout
| fmt-done-x

# Human
$ awf flow step done write-design --flow $FLOWS_DIR/fmt-done-h --output-format human
$ assert_stdout
| marked complete

# JSON
$ awf flow step done write-design --flow $FLOWS_DIR/fmt-done-j --output-format json
$ assert_stdout json
| {"step": "<any_string>"}

# TOML
$ awf flow step done write-design --flow $FLOWS_DIR/fmt-done-t --output-format toml
$ assert_stdout toml
| {"step": "<any_string>"}

# XML
$ awf flow step done write-design --flow $FLOWS_DIR/fmt-done-x --output-format xml
$ assert_stdout xml
| {"step": "<any_string>"}
