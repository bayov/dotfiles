# Test: Full e2e agent session — research → scope → (skip design) → decompose → implement
# Simulates a coding agent driving the workflow throughout.
# Mix of prompt (inline) and prompt_file stages.

# --- Workflow setup ---

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Research, scope, design, decompose, and implement a feature."
|
| [[stages]]
| name = "research"
| description = "Research the problem space."
| produces = ["research.md"]
| kind = "agent"
| args = { prompt = "Research the problem and produce research.md." }
| skippable = true
|
| [[stages]]
| name = "scope"
| description = "Define the scope of work."
| kind = "agent"
| args = { prompt_file = "scope.md" }
|
| [[stages]]
| name = "design"
| description = "Produce a technical design."
| produces = ["design.md"]
| kind = "agent"
| args = { prompt = "Produce a technical design document." }
| skippable = true
|
| [[stages]]
| name = "decompose"
| description = "Break work into tasks."
| kind = "agent"
| args = { prompt_file = "decompose.md" }
| skippable = true
|
| [[stages]]
| name = "implement"
| description = "Write the implementation."
| kind = "agent"
| args = { prompt = "Write the implementation." }

$ write_file .agents/workflows/feature/scope.md
| # Scope
| Define the scope of work.

$ write_file .agents/workflows/feature/decompose.md
| # Decompose
| Break the work into implementation tasks.

# =============================================================================
# Agent creates the flow
# =============================================================================

$ awf flow new $FLOWS_DIR/add-feature --workflow=feature
$ assert_stdout equals
| Created `feature` flow: <...>/add-feature
|
| Workflow `feature` has 5 stages:
| ▶ 1. research (current)
|     - Research the problem space.
|     - Produces: <...>/add-feature/artifacts/research.md
|   2. scope
|     - Define the scope of work.
|   3. design (skippable)
|     - Produce a technical design.
|     - Produces: <...>/add-feature/artifacts/design.md
|   4. decompose (skippable)
|     - Break work into tasks.
|   5. implement
|     - Write the implementation.
|
| Next up (stage: research):
|     - Instructions: Research the problem and produce research.md.
|     - When done, proceed to the next stage with: `awf flow next-stage --flow=<...>/add-feature`

# =============================================================================
# (Alternatively) Agent checks status of existing flow
# =============================================================================

$ awf flow status --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
|     Flow: <...>/add-feature
| Workflow: feature
|   Status: active (stage: research)
|
| Workflow `feature` has 5 stages:
| ▶ 1. research (current)
|     - Research the problem space.
|     - Produces: <...>/add-feature/artifacts/research.md
|   2. scope
|     - Define the scope of work.
|   3. design (skippable)
|     - Produce a technical design.
|     - Produces: <...>/add-feature/artifacts/design.md
|   4. decompose (skippable)
|     - Break work into tasks.
|   5. implement
|     - Write the implementation.
|
| Next up (stage: research):
|     - Instructions: Research the problem and produce research.md.
|     - When done, proceed to the next stage with: `awf flow next-stage --flow=<...>/add-feature`

# =============================================================================
# Stage: research — agent reads instructions, produces artifact, advances
# =============================================================================

$ write_file flows/add-feature/artifacts/research.md
| # Research

$ awf flow next-stage --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| ▶ Entered stage: scope
|
| Workflow `feature` has 5 stages:
| ✓ 1. research (completed)
|     - Research the problem space.
|     - Produced: <...>/add-feature/artifacts/research.md
| ▶ 2. scope (current)
|     - Define the scope of work.
|   3. design (skippable)
|     - Produce a technical design.
|     - Produces: <...>/add-feature/artifacts/design.md
|   4. decompose (skippable)
|     - Break work into tasks.
|   5. implement
|     - Write the implementation.
|
| Next up (stage: scope):
|     - Follow the instructions at: <...>/.agents/workflows/feature/scope.md
|     - When done, proceed to the next stage with: `awf flow next-stage --flow=<...>/add-feature`

