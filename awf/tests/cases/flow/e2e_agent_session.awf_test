# =============================================================================
# Stage: design — agent checks status, decides to skip (stage is skippable)
# =============================================================================

$ awf flow status --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
|     Flow: <...>/add-feature
| Workflow: feature
|   Status: active (stage: design)
|
| Workflow `feature` has 5 stages:
| ✓ 1. research (completed)
|     - Research the problem space.
|     - Produced: <...>/add-feature/artifacts/research.md
| ✓ 2. scope (completed)
|     - Define the scope of work.
| ▶ 3. design (current)
|     - Produce a technical design.
|     - Produces: <...>/add-feature/artifacts/design.md
|   4. decompose (skippable)
|     - Break work into tasks.
|   5. implement
|     - Write the implementation.
|
| Next up (stage: design):
|     - Instructions: Produce a technical design document.
|     - When done, proceed to the next stage with: `awf flow next-stage --flow=<...>/add-feature`

$ awf flow next-stage --skip --flow=$FLOWS_DIR/add-feature
$ assert_exit_code 0
$ assert_stdout equals
| ▶ Entered stage: decompose
|
| Workflow `feature` has 5 stages:
| ✓ 1. research (completed)
|     - Research the problem space.
|     - Produced: <...>/add-feature/artifacts/research.md
| ✓ 2. scope (completed)
|     - Define the scope of work.
| ○ 3. design (skipped)
|     - Produce a technical design.
|     - Skipped artifact: <...>/add-feature/artifacts/design.md
| ▶ 4. decompose (current)
|     - Break work into tasks.
|   5. implement
|     - Write the implementation.
|
| Next up (stage: decompose):
|     - Follow the instructions at: <...>/.agents/workflows/feature/decompose.md
|     - When done, proceed to the next stage with: `awf flow next-stage --flow=<...>/add-feature`
$ assert_stderr contains
| Skipped stage "design"

# Agent manually adds the design artifact after skipping
$ write_file flows/add-feature/artifacts/design.md
| # Design

$ awf flow status --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
|     Flow: <...>/add-feature
| Workflow: feature
|   Status: active (stage: decompose)
|
| Workflow `feature` has 5 stages:
| ✓ 1. research (completed)
|     - Research the problem space.
