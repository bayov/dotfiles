# Test: Full e2e agent session — research → scope → (skip design) → decompose → implement
# Simulates a coding agent driving the workflow throughout.

# --- Workflow setup ---

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Research, scope, design, decompose, and implement a feature."
|
| [[stages]]
| name = "research"
| description = "Research the problem space."
| produces = ["research.md"]
| kind = "agent"
| args = { instructions = "Research the problem and produce research.md." }
| skippable = true
|
| [[stages]]
| name = "scope"
| description = "Define the scope of work."
| kind = "agent"
| args = { instructions = "Define the scope of work." }
|
| [[stages]]
| name = "design"
| description = "Produce a technical design."
| kind = "agent"
| args = { instructions = "Produce a technical design document." }
| skippable = true
|
| [[stages]]
| name = "decompose"
| description = "Break work into tasks."
| kind = "agent"
| args = { instructions = "Break the work into implementation tasks." }
| skippable = true
|
| [[stages]]
| name = "implement"
| description = "Write the implementation."
| kind = "agent"
| args = { instructions = "Write the implementation." }

# =============================================================================
# Agent creates the flow
# =============================================================================

$ awf flow new $FLOWS_DIR/add-feature --workflow=feature
$ assert_stdout equals
| Created flow: <...>/add-feature (workflow: feature, stage: research)
|
| From now on, the "active flow" is <...>/add-feature.
|
| Workflow `feature` has 5 stages:
| 1. research (current)
|     - Research the problem space.
|     - Produces: research.md
| 2. scope
|     - Define the scope of work.
| 3. design (skippable)
|     - Produce a technical design document.
| 4. decompose (skippable)
|     - Break the work into implementation tasks.
| 5. implement
|     - Write the implementation.
|
| Next step is `research`:
|     - Instructions: Research the problem and produce research.md.
|     - Mark complete with: `awf flow done --flow=<...>/add-feature`

# =============================================================================
# Stage: research — agent reads instructions, produces artifact, marks done
# =============================================================================

$ awf flow next-step --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| → Mark complete with: awf flow done

$ write_file flows/add-feature/artifacts/research.md
| # Research

$ awf flow done --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| ✓ Stage research marked complete.

$ awf flow next-stage --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| ▶ Entered stage: scope

# =============================================================================
# Stage: scope — agent reads instructions, marks done, advances
# =============================================================================

$ awf flow next-step --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| → Mark complete with: awf flow done

$ awf flow done --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| ✓ Stage scope marked complete.

$ awf flow next-stage --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| ▶ Entered stage: design

# =============================================================================
# Stage: design — agent checks status, decides to skip (stage is skippable)
# =============================================================================

$ awf flow status --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
|   flow: add-feature
|  stage: design
| status: [● active]

$ awf flow next-stage --skip --flow=$FLOWS_DIR/add-feature
$ assert_exit_code 0
$ assert_stdout equals
| ▶ Entered stage: decompose
$ assert_stderr contains
| Skipped stage "design"

# =============================================================================
# Stage: decompose — agent reads instructions, marks done, advances
# =============================================================================

$ awf flow next-step --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| → Mark complete with: awf flow done

$ awf flow done --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| ✓ Stage decompose marked complete.

$ awf flow next-stage --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| ▶ Entered stage: implement
|   This is the final stage.

# =============================================================================
# Stage: implement (final) — agent reads instructions, marks done
# =============================================================================

$ awf flow next-step --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| → Mark complete with: awf flow done

$ awf flow done --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| ✓ Stage implement marked complete.

# =============================================================================
# Session complete — verify full history
# =============================================================================

$ awf flow history --flow=$FLOWS_DIR/add-feature
$ assert_stdout equals
| <...>/add-feature flow started at <...>
|     ✓ research completed at <...>
|     ✓ scope completed at <...>
|     ⏭ design skipped at <...>
|     ✓ decompose completed at <...>
|     ✓ implement completed at <...>
