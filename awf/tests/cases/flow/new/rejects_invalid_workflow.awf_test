# Test: flow new rejects an invalid workflow
# Pre-flight validation should prevent creating flows from broken workflows.

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

# --- Workflow with an undefined command key ---

$ write_file .agents/workflows/broken-cmd/WORKFLOW.toml
| name = "broken-cmd"
| version = 1
|
| [[stages]]
| name = "work"
| kind = "command"
| args = { command = "no-such-cmd" }

$ awf flow new $FLOWS_DIR/should-not-exist --workflow=broken-cmd
$ assert_exit_code 1
$ assert_stderr contains
| no-such-cmd

# Flow directory must not have been created
$ assert_not_exists flows/should-not-exist/flow_state.toml

# --- Workflow with a missing prompt file ---

$ write_file .agents/workflows/broken-prompt/WORKFLOW.toml
| name = "broken-prompt"
| version = 1
|
| [[stages]]
| name = "ask"
| kind = "agent"
| args = { prompt_file = "ghost.md" }

$ awf flow new $FLOWS_DIR/should-not-exist-2 --workflow=broken-prompt
$ assert_exit_code 1
$ assert_stderr contains
| ghost.md

$ assert_not_exists flows/should-not-exist-2/flow_state.toml

# --- Workflow with a command defined in config should succeed ---

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]
|
| [commands]
| repo-cmd = "true"

$ write_file .agents/workflows/config-cmd/WORKFLOW.toml
| name = "config-cmd"
| version = 1
|
| [[stages]]
| name = "work"
| kind = "command"
| args = { command = "repo-cmd" }

$ awf flow new $FLOWS_DIR/config-cmd-flow --workflow=config-cmd
$ assert_stdout contains
| config-cmd-flow
