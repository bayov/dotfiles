# Test: task-runner error cases
#
# Verifies that task commands reject invalid inputs with useful messages:
#   - tasks * on a non-task-runner stage
#   - next-stage on incomplete task-runner stage
#   - tasks done on a command task
#   - tasks run on an agent task
#   - tasks advance when tasks are not done
#   - tasks next with unknown list name
#   - tasks done with unknown task id

# ---------------------------------------------------------------------------
# Setup: workflow with a linear stage followed by a task-runner stage
# ---------------------------------------------------------------------------

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
|
| [commands]
| test = "true"
|
| [[stages]]
| name = "setup"
| kind = "agent"
| args = { prompt = "Do setup." }
| produces = ["tasks/work.toml"]
|
| [[stages]]
| name = "work"
| type = "task-runner"
| task_lists = ["tasks/work.toml"]

$ write_file flows/err-flow/artifacts/tasks/work.toml
| name = "work"
| description = "Do the work"
| depends_on = []
|
| [[tasks]]
| id = "1.1"
| description = "Agent task"
| type = "agent"
|
| [[tasks]]
| id = "1.2"
| description = "Command task"
| type = "command"
| command = "test"

$ awf flow new $FLOWS_DIR/err-flow --workflow=feature
$ assert_stdout contains
| setup

# ---------------------------------------------------------------------------
# tasks status on a non-task-runner stage → error
# ---------------------------------------------------------------------------

$ awf flow tasks status --flow=$FLOWS_DIR/err-flow
$ assert_exit_code 1
$ assert_stderr contains
| not a task-runner stage

# tasks next on a non-task-runner stage → error
$ awf flow tasks next --flow=$FLOWS_DIR/err-flow
$ assert_exit_code 1
$ assert_stderr contains
| not a task-runner stage

# ---------------------------------------------------------------------------
# next-stage on incomplete task-runner stage → helpful error
# ---------------------------------------------------------------------------

$ awf flow next-stage --flow=$FLOWS_DIR/err-flow
$ assert_stdout contains
| setup

# Now on task-runner stage; next-stage without completing tasks → error
$ awf flow next-stage --flow=$FLOWS_DIR/err-flow
$ assert_exit_code 1
$ assert_stderr contains
| not yet complete

# ---------------------------------------------------------------------------
# tasks done on a command task → error
# ---------------------------------------------------------------------------

$ awf flow tasks done work 1.2 --flow=$FLOWS_DIR/err-flow
$ assert_exit_code 1
$ assert_stderr contains
| command task

# tasks run on an agent task → error
$ awf flow tasks run work 1.1 --flow=$FLOWS_DIR/err-flow
$ assert_exit_code 1
$ assert_stderr contains
| agent task

# ---------------------------------------------------------------------------
# tasks advance when not all tasks done → error
# ---------------------------------------------------------------------------

$ awf flow tasks advance work --flow=$FLOWS_DIR/err-flow
$ assert_exit_code 1
$ assert_stderr contains
| incomplete tasks

# ---------------------------------------------------------------------------
# tasks next with unknown list name → error
# ---------------------------------------------------------------------------

$ awf flow tasks next --list=nonexistent --flow=$FLOWS_DIR/err-flow
$ assert_exit_code 1
$ assert_stderr contains
| nonexistent

# ---------------------------------------------------------------------------
# tasks done with unknown task id → error
# ---------------------------------------------------------------------------

$ awf flow tasks done work 9.9 --flow=$FLOWS_DIR/err-flow
$ assert_exit_code 1
$ assert_stderr contains
| 9.9
