# Test: task-runner happy path — serial mode, one list with agent and command tasks
#
# Simulates a full agent session through a task-runner stage:
#   1. flow new → task-breakdown stage (agent)
#   2. next-stage → implement stage (task-runner) — state initialized
#   3. tasks status — shows lists
#   4. tasks next — shows first task
#   5. tasks done / tasks run — complete tasks
#   6. tasks advance — marks list complete
#   7. next-stage — exits the task-runner stage

# ---------------------------------------------------------------------------
# Setup: workflow + config
# ---------------------------------------------------------------------------

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
|
| [commands]
| format = "true"
| test = "true"
|
| [[stages]]
| name = "task-breakdown"
| kind = "agent"
| args = { prompt = "Produce task lists." }
| produces = ["tasks/impl.toml"]
|
| [[stages]]
| name = "implement"
| type = "task-runner"
| task_lists = ["tasks/impl.toml"]

# ---------------------------------------------------------------------------
# Create flow — starts on task-breakdown (agent stage)
# ---------------------------------------------------------------------------

$ awf flow new $FLOWS_DIR/my-flow --workflow=feature
$ assert_stdout contains
| task-breakdown

# ---------------------------------------------------------------------------
# Produce the task list artifact (simulate agent output)
# ---------------------------------------------------------------------------

$ write_file flows/my-flow/artifacts/tasks/impl.toml
| name = "impl"
| description = "Implement the feature"
| depends_on = []
|
| [[tasks]]
| id = "1.1"
| description = "Scaffold the module"
| type = "agent"
|
| [[tasks]]
| id = "1.2"
| description = "Write tests"
| type = "agent"
|
| [[tasks]]
| id = "1.3"
| description = "Run formatter"
| type = "command"
| command = "format"
|
| [[tasks]]
| id = "1.4"
| description = "Run tests"
| type = "command"
| command = "test"

# ---------------------------------------------------------------------------
# Advance from task-breakdown → implement (task-runner)
# State should be initialized: impl → pending
# ---------------------------------------------------------------------------

$ awf flow next-stage --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| implement

# ---------------------------------------------------------------------------
# tasks status — shows the list as pending with all tasks
# ---------------------------------------------------------------------------

$ awf flow tasks status --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| Task-runner stage: implement
$ assert_stdout contains
| impl
$ assert_stdout contains
| pending
$ assert_stdout contains
| 1.1
$ assert_stdout contains
| 1.2
$ assert_stdout contains
| 1.3
$ assert_stdout contains
| 1.4

# ---------------------------------------------------------------------------
# tasks next — first task in list
# ---------------------------------------------------------------------------

$ awf flow tasks next --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| impl/1.1
$ assert_stdout contains
| Scaffold the module
$ assert_stdout contains
| awf flow tasks done impl 1.1

# ---------------------------------------------------------------------------
# tasks done 1.1 — mark agent task complete
# ---------------------------------------------------------------------------

$ awf flow tasks done impl 1.1 --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| impl/1.1

# ---------------------------------------------------------------------------
# tasks next — second task
# ---------------------------------------------------------------------------

$ awf flow tasks next --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| impl/1.2
$ assert_stdout contains
| awf flow tasks done impl 1.2

# ---------------------------------------------------------------------------
# tasks done 1.2
# ---------------------------------------------------------------------------

$ awf flow tasks done impl 1.2 --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| impl/1.2

# ---------------------------------------------------------------------------
# tasks run 1.3 — command task (format), should pass
# ---------------------------------------------------------------------------

$ awf flow tasks run impl 1.3 --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| PASS
$ assert_stdout contains
| impl/1.3

# ---------------------------------------------------------------------------
# tasks run 1.4 — command task (test), should pass
# ---------------------------------------------------------------------------

$ awf flow tasks run impl 1.4 --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| PASS
$ assert_stdout contains
| impl/1.4

# ---------------------------------------------------------------------------
# tasks next — all tasks done, no next task → advance suggestion
# ---------------------------------------------------------------------------

$ awf flow tasks next --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| awf flow tasks advance

# No more tasks
$ assert_stdout not_contains
| impl/1.

# ---------------------------------------------------------------------------
# tasks status — all tasks should show as done
# ---------------------------------------------------------------------------

$ awf flow tasks status --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| impl
$ assert_stdout contains
| in-progress

# ---------------------------------------------------------------------------
# tasks advance — mark list complete, impl → complete
# ---------------------------------------------------------------------------

$ awf flow tasks advance impl --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| complete
$ assert_stdout contains
| next-stage

# ---------------------------------------------------------------------------
# tasks status — list is complete
# ---------------------------------------------------------------------------

$ awf flow tasks status --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| complete

# ---------------------------------------------------------------------------
# next-stage — exits the task-runner stage (final stage → done)
# ---------------------------------------------------------------------------

$ awf flow next-stage --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| implement marked complete

# ---------------------------------------------------------------------------
# Verify state.toml reflects completed state
# ---------------------------------------------------------------------------

$ awf flow status --flow=$FLOWS_DIR/my-flow
$ assert_stdout contains
| completed
