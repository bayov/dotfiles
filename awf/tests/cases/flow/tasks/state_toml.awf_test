# Test: task_runner_state and task_log are persisted correctly in state.toml
#
# Reads the raw state.toml after each mutation to verify TOML structure.

# ---------------------------------------------------------------------------
# Setup
# ---------------------------------------------------------------------------

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
|
| [commands]
| test = "true"
|
| [[stages]]
| name = "plan"
| kind = "agent"
| args = { prompt = "Plan." }
| produces = ["tasks/a.toml", "tasks/b.toml"]
|
| [[stages]]
| name = "execute"
| type = "task-runner"
| task_lists = ["tasks/a.toml", "tasks/b.toml"]

$ write_file flows/state-flow/artifacts/tasks/a.toml
| name = "a"
| description = "Task list A"
| depends_on = []
|
| [[tasks]]
| id = "a1"
| description = "First agent task"
| type = "agent"
|
| [[tasks]]
| id = "a2"
| description = "First command task"
| type = "command"
| command = "test"

$ write_file flows/state-flow/artifacts/tasks/b.toml
| name = "b"
| description = "Task list B"
| depends_on = ["a"]
|
| [[tasks]]
| id = "b1"
| description = "Dependent agent task"
| type = "agent"

# ---------------------------------------------------------------------------
# Create flow + advance to execute (task-runner)
# ---------------------------------------------------------------------------

$ awf flow new $FLOWS_DIR/state-flow --workflow=feature
$ assert_stdout contains
| plan

$ awf flow next-stage --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| execute

# After entering execute: task_runner_state should be in state.toml
# a → pending (no deps), b → blocked (depends_on: [a])
$ awf flow status --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| execute

# Verify via TOML that task_runner_state is set
$ awf flow tasks status --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| a
$ assert_stdout contains
| b
$ assert_stdout contains
| blocked

# ---------------------------------------------------------------------------
# Mark a1 done → a transitions to in-progress
# ---------------------------------------------------------------------------

$ awf flow tasks done a a1 --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| a/a1

$ awf flow tasks status --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| in-progress

# ---------------------------------------------------------------------------
# Run a2 (command) → still in-progress
# ---------------------------------------------------------------------------

$ awf flow tasks run a a2 --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| PASS

# ---------------------------------------------------------------------------
# Advance a → complete, b unblocks to pending
# ---------------------------------------------------------------------------

$ awf flow tasks advance a --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| complete

$ awf flow tasks status --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| complete
# b is no longer blocked
$ assert_stdout not_contains
| blocked

# ---------------------------------------------------------------------------
# Complete b1 and advance b → all done
# ---------------------------------------------------------------------------

$ awf flow tasks done b b1 --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| b/b1

$ awf flow tasks advance b --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| next-stage

# All lists complete — verify status shows both complete
$ awf flow tasks status --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| complete
$ assert_stdout not_contains
| pending
$ assert_stdout not_contains
| in-progress
$ assert_stdout not_contains
| blocked

# Advance the stage
$ awf flow next-stage --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| execute marked complete

$ awf flow status --flow=$FLOWS_DIR/state-flow
$ assert_stdout contains
| completed
