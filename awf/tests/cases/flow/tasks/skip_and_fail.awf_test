# Test: tasks skip and failed command task
#
# Verifies:
#   - tasks skip records a skipped entry with a reason
#   - a failed command task appears as FAIL in output
#   - after a failure, tasks next does not advance past the failing task
#   - re-running a failed task succeeds and unblocks the next task

# ---------------------------------------------------------------------------
# Setup
# ---------------------------------------------------------------------------

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
|
| [commands]
| pass = "true"
| fail = "false"
|
| [[stages]]
| name = "work"
| type = "task-runner"
| task_lists = ["tasks/work.toml"]

$ write_file flows/sf-flow/artifacts/tasks/work.toml
| name = "work"
| description = "Work tasks"
| depends_on = []
|
| [[tasks]]
| id = "1.1"
| description = "Optional setup"
| type = "agent"
|
| [[tasks]]
| id = "1.2"
| description = "Failing command"
| type = "command"
| command = "fail"
|
| [[tasks]]
| id = "1.3"
| description = "Passing command"
| type = "command"
| command = "pass"
|
| [[tasks]]
| id = "1.4"
| description = "Final agent task"
| type = "agent"

$ awf flow new $FLOWS_DIR/sf-flow --workflow=feature
$ assert_stdout contains
| work

# ---------------------------------------------------------------------------
# tasks skip 1.1 — skip optional setup
# ---------------------------------------------------------------------------

$ awf flow tasks skip work 1.1 --reason="not needed for this run" --flow=$FLOWS_DIR/sf-flow
$ assert_stdout contains
| Skipped work/1.1
$ assert_stdout contains
| not needed for this run

# ---------------------------------------------------------------------------
# tasks next — should show 1.2 (1.1 is done via skip)
# ---------------------------------------------------------------------------

$ awf flow tasks next --flow=$FLOWS_DIR/sf-flow
$ assert_stdout contains
| work/1.2
$ assert_stdout contains
| Failing command

# ---------------------------------------------------------------------------
# tasks run 1.2 — command fails
# ---------------------------------------------------------------------------

$ awf flow tasks run work 1.2 --flow=$FLOWS_DIR/sf-flow
$ assert_stdout contains
| FAIL
$ assert_stdout contains
| work/1.2

# ---------------------------------------------------------------------------
# tasks next — returns the failing task for re-run
# ---------------------------------------------------------------------------

$ awf flow tasks next --flow=$FLOWS_DIR/sf-flow
$ assert_exit_code 0
$ assert_stdout contains
| work/1.2
$ assert_stdout contains
| awf flow tasks run

# tasks status shows 1.2 as failed
$ awf flow tasks status --flow=$FLOWS_DIR/sf-flow
$ assert_stdout contains
| 1.2
$ assert_stdout contains
| 1.3

# ---------------------------------------------------------------------------
# Re-run 1.2 — this time with pass command (simulate fix)
# We swap the command by writing a new task list that uses pass
# ---------------------------------------------------------------------------

$ write_file flows/sf-flow/artifacts/tasks/work.toml
| name = "work"
| description = "Work tasks"
| depends_on = []
|
| [[tasks]]
| id = "1.1"
| description = "Optional setup"
| type = "agent"
|
| [[tasks]]
| id = "1.2"
| description = "Fixed command"
| type = "command"
| command = "pass"
|
| [[tasks]]
| id = "1.3"
| description = "Passing command"
| type = "command"
| command = "pass"
|
| [[tasks]]
| id = "1.4"
| description = "Final agent task"
| type = "agent"

$ awf flow tasks run work 1.2 --flow=$FLOWS_DIR/sf-flow
$ assert_stdout contains
| PASS

# ---------------------------------------------------------------------------
# Complete remaining tasks and advance
# ---------------------------------------------------------------------------

$ awf flow tasks run work 1.3 --flow=$FLOWS_DIR/sf-flow
$ assert_stdout contains
| PASS

$ awf flow tasks done work 1.4 --flow=$FLOWS_DIR/sf-flow
$ assert_stdout contains
| work/1.4

$ awf flow tasks advance work --flow=$FLOWS_DIR/sf-flow
$ assert_stdout contains
| next-stage

$ awf flow next-stage --flow=$FLOWS_DIR/sf-flow
$ assert_stdout contains
| work marked complete
