# Test: archive hides flow from list, --all shows it
# Converts: archive_and_list

# --- Setup: feature workflow ---

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a new feature from design through merge."
|
| [commands]
| test = "cargo test"
| lint = "cargo clippy -- -D warnings"
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| produces = ["design.md"]
| kind = "agent"
| args = { prompt = "design.md" }
|
| [[stages]]
| name = "write-code"
| description = "Write the code."
| kind = "agent"
| args = { prompt = "implement.md" }
|
| [[stages]]
| name = "test"
| kind = "command"
| args = { command = "test" }
|
| [[stages]]
| name = "pre-review-test"
| kind = "command"
| args = { command = "test" }
|
| [[stages]]
| name = "do-review"
| description = "Code review and integration."
| produces = ["changelog-entry.md"]
| kind = "agent"
| args = { prompt = "review.md" }

$ write_file .agents/workflows/feature/design.md
| # Design
| Write a design document.

$ write_file .agents/workflows/feature/implement.md
| # Implement
| Write the implementation.

$ write_file .agents/workflows/feature/review.md
| # Review
| Perform code review.

# --- Test ---

$ awf flow new $FLOWS_DIR/add-oauth --workflow feature
$ assert_stdout contains
| add-oauth

# Flow appears in normal list
$ awf flow list
$ assert_stdout contains
| add-oauth

# Archive the flow
$ awf flow archive --flow $FLOWS_DIR/add-oauth
$ assert_stdout contains
| add-oauth

# Status still works after archiving (path-based load)
$ awf flow status --flow $FLOWS_DIR/add-oauth
$ assert_stdout contains
| design

# Plain list does NOT show archived flow
$ awf flow list
$ assert_stdout not_contains
| add-oauth

# list --all shows archived flow
$ awf flow list --all
$ assert_stdout contains
| add-oauth
$ assert_stdout contains
| archived
