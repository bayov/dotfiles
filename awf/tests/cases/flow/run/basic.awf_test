# Test: flow run pass and fail
# Creates a flow with the run-test workflow, runs a passing stage and a failing stage.

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "pass-step"
| kind = "command"
| args = { run = "true" }
|
| [[stages]]
| name = "fail-step"
| kind = "command"
| args = { run = "false" }

# Step 1: Create flow
$ awf flow new $FLOWS_DIR/run-flow --workflow=run-test
$ assert_stdout contains
| run-flow

# Step 2: Run pass-step stage (should pass)
$ awf flow run --flow=$FLOWS_DIR/run-flow
$ assert_stdout contains
| PASS

# Step 3: Advance to fail-step stage
$ awf flow next-stage --flow=$FLOWS_DIR/run-flow
$ assert_stdout contains
| fail-step

# Step 4: Run fail-step stage (reports FAIL in stdout, but exits 0)
$ awf flow run --flow=$FLOWS_DIR/run-flow
$ assert_stdout contains
| FAIL
