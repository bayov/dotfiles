# Test: flow run fail then rerun reflects pass
# Runs a failing stage, fixes the workflow so it passes, reruns, and checks status.

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "fail-step"
| kind = "command"
| args = { run = "false" }

# Step 1: Create flow
$ awf flow new $FLOWS_DIR/retry-flow --workflow=run-test
$ assert_stdout contains
| retry-flow

# Step 2: Run fail-step (fails)
$ awf flow run --flow=$FLOWS_DIR/retry-flow
$ assert_stdout contains
| FAIL

# Step 3: Rewrite WORKFLOW.toml so fail-step now passes
$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "fail-step"
| kind = "command"
| args = { run = "true" }

# Step 4: Run fail-step again (should now pass)
$ awf flow run --flow=$FLOWS_DIR/retry-flow
$ assert_stdout contains
| PASS

# Step 5: Check status reflects completed
$ awf flow status --flow=$FLOWS_DIR/retry-flow
$ assert_stdout contains
| completed
