# Test: --skip bypasses all gates on skippable stages

# --- Setup ---

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/with-skippable/WORKFLOW.toml
| name = "with-skippable"
| version = 1
|
| [[stages]]
| name = "research"
| skippable = true
| produces = ["research.md"]
| kind = "agent"
| args = { instructions = "Research." }
|
| [[stages]]
| name = "implement"
| kind = "agent"
| args = { instructions = "Code." }
|
| [[stages]]
| name = "review"
| kind = "command"
| args = { run = "true" }

$ write_file .agents/workflows/no-skip/WORKFLOW.toml
| name = "no-skip"
| version = 1
|
| [[stages]]
| name = "work"
| kind = "command"
| args = { run = "true" }
|
| [[stages]]
| name = "done"
| kind = "command"
| args = { run = "true" }

# =============================================================================
# Test 1: --skip bypasses all gates (stage completion AND artifacts)
# =============================================================================

$ awf flow new $FLOWS_DIR/skip-flow --workflow=with-skippable
$ assert_stdout contains
| skip-flow

# --skip bypasses stage completion and artifact gates
$ awf flow next-stage --skip --flow=$FLOWS_DIR/skip-flow
$ assert_exit_code 0
$ assert_stdout contains
| implement
$ assert_stderr contains
| Skipped stage

# =============================================================================
# Test 2: --skip on non-skippable stage is rejected
# =============================================================================

$ awf flow new $FLOWS_DIR/no-skip-flow --workflow=no-skip
$ assert_stdout contains
| no-skip-flow

$ awf flow next-stage --skip --flow=$FLOWS_DIR/no-skip-flow
$ assert_exit_code 1
$ assert_stderr contains
| not marked as skippable

# =============================================================================
# Test 3: --skip records skipped in history
# =============================================================================

$ awf flow new $FLOWS_DIR/skip-history --workflow=with-skippable
$ assert_stdout contains
| skip-history

$ awf flow next-stage --skip --flow=$FLOWS_DIR/skip-history
$ assert_exit_code 0
$ assert_stdout contains
| implement
$ assert_stderr contains
| Skipped stage

# History shows skipped
$ awf flow history --flow=$FLOWS_DIR/skip-history
$ assert_stdout contains
| skipped

# =============================================================================
# Test 4: --skip and --force cannot be used together
# =============================================================================

$ awf flow new $FLOWS_DIR/skip-force --workflow=with-skippable
$ assert_stdout contains
| skip-force

$ awf flow next-stage --skip --force="reason" --flow=$FLOWS_DIR/skip-force
$ assert_exit_code 1
$ assert_stderr contains
| cannot be used together
