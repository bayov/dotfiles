# Test: flow next-stage rejects an invalid workflow
# Pre-flight validation catches broken workflows before advancing.

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

# --- Valid workflow to create a flow and complete a stage ---

$ write_file .agents/workflows/will-break/WORKFLOW.toml
| name = "will-break"
| version = 1
|
| [commands]
| check = "true"
|
| [[stages]]
| name = "first"
| steps = [
|     { name = "run-check", type = "command", command = "check" },
| ]
|
| [[stages]]
| name = "second"
| steps = []

$ awf flow new $FLOWS_DIR/adv-flow --workflow will-break
$ assert_stdout contains
| adv-flow

$ awf flow run run-check --flow $FLOWS_DIR/adv-flow
$ assert_stdout contains
| PASS

# --- Break the workflow by removing the command definition ---

$ write_file .agents/workflows/will-break/WORKFLOW.toml
| name = "will-break"
| version = 1
|
| [[stages]]
| name = "first"
| steps = [
|     { name = "run-check", type = "command", command = "check" },
| ]
|
| [[stages]]
| name = "second"
| steps = []

# next-stage should catch the broken workflow
$ awf flow next-stage --flow $FLOWS_DIR/adv-flow
$ assert_exit_code 1
$ assert_stderr contains
| failed validation
$ assert_stderr contains
| check
