# Test: --force bypasses step-completion gate but not missing artifacts

# --- Setup ---

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "work"
| steps = [
|     { name = "pass-step", type = "command", run = "true" },
|     { name = "fail-step", type = "command", run = "false" },
| ]

$ write_file .agents/workflows/with-artifact/WORKFLOW.toml
| name = "with-artifact"
| version = 1
|
| [[stages]]
| name = "draft"
| produces = ["draft.md"]
| steps = [{ name = "write", type = "agent", instructions = "Write it." }]
|
| [[stages]]
| name = "done"
| steps = [{ name = "finalize", type = "agent", instructions = "Finalize." }]

# =============================================================================
# Test 1: --force bypasses step gate
# =============================================================================

$ awf flow new $FLOWS_DIR/force-flow --workflow run-test
$ assert_stdout contains
| force-flow

# Without --force: fails because steps are incomplete
$ awf flow next-stage --flow $FLOWS_DIR/force-flow
$ assert_exit_code 1
$ assert_stderr contains
| not complete

# With --force: step gate bypassed.
# run-test has only one stage, so this errors with "last stage".
$ awf flow next-stage --force "skipping steps" --flow $FLOWS_DIR/force-flow
$ assert_exit_code 1
$ assert_stderr contains
| last stage
$ assert_stderr not_contains
| pass-step
$ assert_stderr not_contains
| fail-step

# =============================================================================
# Test 2: --force records force_completed with reason in history
# =============================================================================

$ awf flow new $FLOWS_DIR/force-history --workflow with-artifact
$ assert_stdout contains
| force-history

# Write artifact and force-advance (step not done but artifact present)
$ write_file flows/force-history/artifacts/draft.md
| placeholder
$ awf flow next-stage --force "skipping steps" --flow $FLOWS_DIR/force-history
$ assert_stdout contains
| done

# History shows force completed with reason
$ awf flow history --flow $FLOWS_DIR/force-history --output-format human
$ assert_stdout contains
| force completed

$ awf flow history --flow $FLOWS_DIR/force-history --output-format json
$ assert_stdout json
| {
|   "entries": [
|     {
|       "stage": "draft",
|       "started_at": "<any_string>",
|       "completed_at": "<any_string>",
|       "force_completed": true,
|       "force_reason": "<any_string>",
|       "steps": []
|     },
|     {
|       "stage": "done",
|       "started_at": "<any_string>",
|       "steps": []
|     }
|   ]
| }

# =============================================================================
# Test 3: --force still rejects missing produces artifacts
# =============================================================================

$ awf flow new $FLOWS_DIR/force-no-artifact --workflow with-artifact
$ assert_stdout contains
| force-no-artifact

# --force without the required artifact: still blocked
$ awf flow next-stage --force "skipping steps" --flow $FLOWS_DIR/force-no-artifact
$ assert_exit_code 1
$ assert_stderr contains
| draft.md
