# Test: --force bypasses stage-completion gate but not missing artifacts

# --- Setup ---

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "pass-step"
| kind = "command"
| args = { run = "true" }
|
| [[stages]]
| name = "fail-step"
| kind = "command"
| args = { run = "false" }

$ write_file .agents/workflows/with-artifact/WORKFLOW.toml
| name = "with-artifact"
| version = 1
|
| [[stages]]
| name = "draft"
| produces = ["draft.md"]
| kind = "agent"
| args = { instructions = "Write it." }
|
| [[stages]]
| name = "done"
| kind = "agent"
| args = { instructions = "Finalize." }

# =============================================================================
# Test 1: --force bypasses stage gate
# =============================================================================

$ awf flow new $FLOWS_DIR/force-flow --workflow=run-test
$ assert_stdout contains
| force-flow

# Without --force: fails because stage is incomplete (not run yet)
$ awf flow next-stage --flow=$FLOWS_DIR/force-flow
$ assert_exit_code 1
$ assert_stderr contains
| not complete

# With --force: stage gate bypassed.
# run-test first stage is pass-step; force advances to fail-step.
# fail-step is the last stage, so next advance errors with "last stage".
$ awf flow next-stage --force="skipping stage" --flow=$FLOWS_DIR/force-flow
$ assert_stdout contains
| fail-step

$ awf flow next-stage --force="skipping stage" --flow=$FLOWS_DIR/force-flow
$ assert_exit_code 1
$ assert_stderr contains
| last stage

# =============================================================================
# Test 2: --force records force_completed with reason in history
# =============================================================================

$ awf flow new $FLOWS_DIR/force-history --workflow=with-artifact
$ assert_stdout contains
| force-history

# Write artifact and force-advance (stage not done but artifact present)
$ write_file flows/force-history/artifacts/draft.md
| placeholder
$ awf flow next-stage --force="skipping stage" --flow=$FLOWS_DIR/force-history
$ assert_stdout contains
| done

# History shows force completed with reason
$ awf flow history --flow=$FLOWS_DIR/force-history
$ assert_stdout contains
| force completed

# =============================================================================
# Test 3: --force still rejects missing produces artifacts
# =============================================================================

$ awf flow new $FLOWS_DIR/force-no-artifact --workflow=with-artifact
$ assert_stdout contains
| force-no-artifact

# --force without the required artifact: still blocked
$ awf flow next-stage --force="skipping stage" --flow=$FLOWS_DIR/force-no-artifact
$ assert_exit_code 1
$ assert_stderr contains
| draft.md
