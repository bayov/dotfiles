# Test: advance blocked by failed stage, then unblocked after fix
# Converts: advance_blocked_by_failed_step

# --- Setup: run-test workflow ---

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "pass-step"
| kind = "command"
| args = { run = "true" }
|
| [[stages]]
| name = "fail-step"
| kind = "command"
| args = { run = "false" }

# --- Test ---

$ awf flow new $FLOWS_DIR/blocker-flow --workflow=run-test
$ assert_stdout contains
| blocker-flow

# Run pass-step stage: succeeds
$ awf flow run --flow=$FLOWS_DIR/blocker-flow
$ assert_stdout contains
| PASS

# Advance to fail-step stage
$ awf flow next-stage --flow=$FLOWS_DIR/blocker-flow
$ assert_stdout contains
| fail-step

# Run fail-step stage: reports FAIL (exit 0 — failure is in the stage, not the CLI)
$ awf flow run --flow=$FLOWS_DIR/blocker-flow
$ assert_stdout contains
| FAIL

# Advance should fail because fail-step failed
$ awf flow next-stage --flow=$FLOWS_DIR/blocker-flow
$ assert_exit_code 1
$ assert_stderr contains
| fail-step

# Fix the workflow so fail-step now passes
$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "pass-step"
| kind = "command"
| args = { run = "true" }
|
| [[stages]]
| name = "fail-step"
| kind = "command"
| args = { run = "true" }

# Re-run fail-step: now passes
$ awf flow run --flow=$FLOWS_DIR/blocker-flow
$ assert_stdout contains
| PASS

# Advance: no longer blocked by fail-step.
# run-test has only two stages and we're on the last, so this errors with "last stage".
$ awf flow next-stage --flow=$FLOWS_DIR/blocker-flow
$ assert_exit_code 1
$ assert_stderr contains
| last stage
$ assert_stderr not_contains
| fail-step
