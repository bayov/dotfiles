# Test: advance blocked by missing artifact, then unblocked after creating it

# --- Feature workflow setup ---
$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a new feature from design through merge."
|
| [commands]
| test = "cargo test"
| lint = "cargo clippy -- -D warnings"
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| produces = ["design.md"]
| kind = "agent"
| args = { prompt_file = "design.md" }
|
| [[stages]]
| name = "write-code"
| description = "Write the code."
| kind = "agent"
| args = { prompt_file = "implement.md" }
|
| [[stages]]
| name = "test"
| kind = "command"
| args = { command = "test" }
|
| [[stages]]
| name = "pre-review-test"
| kind = "command"
| args = { command = "test" }
|
| [[stages]]
| name = "do-review"
| description = "Code review and integration."
| produces = ["changelog-entry.md"]
| kind = "agent"
| args = { prompt_file = "review.md" }

$ write_file .agents/workflows/feature/design.md
| # Design
| Write a design document.

$ write_file .agents/workflows/feature/implement.md
| # Implement
| Write the implementation.

$ write_file .agents/workflows/feature/review.md
| # Review
| Perform code review.

# --- Create a new flow ---
$ awf flow new $FLOWS_DIR/add-oauth --workflow=feature
$ assert_stdout contains
| add-oauth

# --- Advance should fail: design.md artifact is missing ---
$ awf flow next-stage --flow=$FLOWS_DIR/add-oauth
$ assert_exit_code 1
$ assert_stderr contains
| design.md

# --- Write the missing artifact ---
$ write_file flows/add-oauth/artifacts/design.md
| # My design

# --- Advance should now succeed ---
$ awf flow next-stage --flow=$FLOWS_DIR/add-oauth
$ assert_stdout contains
| write-code
