# Tests for `awf flow next-step` behavior

# --- Setup: config ---
$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

# --- Setup: feature workflow ---
$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a new feature from design through merge."
|
| [commands]
| test = "cargo test"
| lint = "cargo clippy -- -D warnings"
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| produces = ["design.md"]
| kind = "agent"
| args = { prompt = "design.md" }
|
| [[stages]]
| name = "write-code"
| description = "Write the code."
| kind = "agent"
| args = { prompt = "implement.md" }
|
| [[stages]]
| name = "test"
| kind = "command"
| args = { command = "test" }
|
| [[stages]]
| name = "pre-review-test"
| kind = "command"
| args = { command = "test" }
|
| [[stages]]
| name = "do-review"
| description = "Code review and integration."
| produces = ["changelog-entry.md"]
| kind = "agent"
| args = { prompt = "review.md" }

$ write_file .agents/workflows/feature/design.md
| # Design
| Write a design document.

$ write_file .agents/workflows/feature/implement.md
| # Implement
| Write the implementation.

$ write_file .agents/workflows/feature/review.md
| # Review
| Perform code review.

# --- Setup: run-test workflow ---
$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "pass-step"
| kind = "command"
| args = { run = "true" }
|
| [[stages]]
| name = "fail-step"
| kind = "command"
| args = { run = "false" }

# =============================================================================
# Test 1: flow_next_failing_step_hints_run
# =============================================================================

$ awf flow new $FLOWS_DIR/next-flow --workflow=run-test
$ assert_stdout contains
| next-flow

# Run first stage (pass-step) and advance to fail-step
$ awf flow run --flow=$FLOWS_DIR/next-flow
$ assert_stdout contains
| PASS

$ awf flow next-stage --flow=$FLOWS_DIR/next-flow
$ assert_stdout contains
| fail-step

# Run fail-step stage
$ awf flow run --flow=$FLOWS_DIR/next-flow
$ assert_stdout contains
| FAIL

$ awf flow next-step --flow=$FLOWS_DIR/next-flow
$ assert_stdout contains
| awf flow run

# =============================================================================
# Test 2: flow_next_incomplete_agent_step_hints_done
# =============================================================================

$ awf flow new $FLOWS_DIR/next-agent --workflow=feature
$ assert_stdout contains
| next-agent

$ awf flow next-step --flow=$FLOWS_DIR/next-agent
$ assert_stdout contains
| Mark complete with

# =============================================================================
# Test 3: flow_next_missing_artifact_mentions_artifact_name
# =============================================================================

$ awf flow new $FLOWS_DIR/next-artifact --workflow=feature
$ assert_stdout contains
| next-artifact

$ awf flow next-stage --flow=$FLOWS_DIR/next-artifact
$ assert_exit_code 1
$ assert_stderr contains
| design.md

$ awf flow next-step --flow=$FLOWS_DIR/next-artifact
$ assert_stdout contains
| design.md

# =============================================================================
# Test 4: flow_next_can_advance_mentions_advance_command
# =============================================================================

$ awf flow new $FLOWS_DIR/next-advance --workflow=feature
$ assert_stdout contains
| next-advance

$ awf flow next-stage --flow=$FLOWS_DIR/next-advance
$ assert_exit_code 1
$ assert_stderr contains
| design.md

$ write_file flows/next-advance/artifacts/design.md
| # My design

$ awf flow next-step --flow=$FLOWS_DIR/next-advance
$ assert_stdout contains
| awf flow next-stage
