# Test: flow next-step rejects an invalid workflow
# Pre-flight validation catches broken workflows before computing next action.

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

# --- Valid workflow to create a flow ---

$ write_file .agents/workflows/will-break/WORKFLOW.toml
| name = "will-break"
| version = 1
|
| [commands]
| check = "true"
|
| [[stages]]
| name = "work"
| kind = "command"
| args = { command = "check" }

$ awf flow new $FLOWS_DIR/ns-flow --workflow will-break
$ assert_stdout contains
| ns-flow

# --- Break the workflow by removing the command definition ---

$ write_file .agents/workflows/will-break/WORKFLOW.toml
| name = "will-break"
| version = 1
|
| [[stages]]
| name = "work"
| kind = "command"
| args = { command = "check" }

# next-step should catch the broken workflow
$ awf flow next-step --flow $FLOWS_DIR/ns-flow
$ assert_exit_code 1
$ assert_stderr contains
| failed validation
$ assert_stderr contains
| check
