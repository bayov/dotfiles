# Test: awf flow validate
# Tests validation of flow artifact state.

# --- Setup: feature workflow ---

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a new feature from design through merge."
|
| [commands]
| test = "cargo test"
| lint = "cargo clippy -- -D warnings"
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| produces = ["design.md"]
| steps = [
|     { name = "write-design", type = "agent", prompt = "design.md" },
| ]
|
| [[stages]]
| name = "implement"
| description = "Write the code."
| steps = [
|     { name = "write-code", type = "agent", prompt = "implement.md" },
|     { name = "test", type = "command", command = "test" },
| ]
|
| [[stages]]
| name = "review"
| description = "Code review and integration."
| produces = ["changelog-entry.md"]
| steps = [
|     { name = "pre-review-test", type = "command", command = "test" },
|     { name = "do-review", type = "agent", prompt = "review.md" },
| ]
|
$ write_file .agents/workflows/feature/design.md
| # Design
| Write a design document.

$ write_file .agents/workflows/feature/implement.md
| # Implement
| Write the implementation.

$ write_file .agents/workflows/feature/review.md
| # Review
| Perform code review.

# --- Setup: produces-only workflow (no requires gate) ---

$ write_file .agents/workflows/produces-only/WORKFLOW.toml
| name = "produces-only"
| version = 1
|
| [[stages]]
| name = "draft"
| produces = ["draft.md"]
| steps = [{ name = "write", type = "agent", instructions = "Write it." }]
|
| [[stages]]
| name = "polish"
| steps = [{ name = "refine", type = "agent", instructions = "Refine it." }]

# -------------------------------------------------------
# Test 1: validate passes when no stages completed
# -------------------------------------------------------

$ awf flow new $FLOWS_DIR/validate-empty --workflow feature
$ assert_stdout contains
| validate-empty

$ awf flow validate --flow $FLOWS_DIR/validate-empty
$ assert_stdout contains
| valid

# -------------------------------------------------------
# Test 2: validate passes when completed stage artifacts present
# -------------------------------------------------------

$ awf flow new $FLOWS_DIR/validate-ok --workflow feature
$ assert_stdout contains
| validate-ok

$ write_file flows/validate-ok/artifacts/design.md
| # Design

$ awf flow step done write-design --flow $FLOWS_DIR/validate-ok
$ assert_stdout contains
| write-design

$ awf flow next-stage --flow $FLOWS_DIR/validate-ok
$ assert_stdout contains
| implement

$ awf flow validate --flow $FLOWS_DIR/validate-ok
$ assert_stdout contains
| valid

# -------------------------------------------------------
# Test 3: validate fails for missing artifact
# -------------------------------------------------------

$ awf flow new $FLOWS_DIR/validate-missing --workflow produces-only
$ assert_stdout contains
| validate-missing

# Write the artifact, advance, then delete to create invalid state
$ write_file flows/validate-missing/artifacts/draft.md
| placeholder
$ awf flow step done write --flow $FLOWS_DIR/validate-missing
$ assert_stdout contains
| write
$ awf flow next-stage --flow $FLOWS_DIR/validate-missing
$ assert_stdout contains
| polish
$ delete flows/validate-missing/artifacts/draft.md

$ awf flow validate --flow $FLOWS_DIR/validate-missing
$ assert_exit_code 1
$ assert_stderr contains
| missing artifact: draft.md

# -------------------------------------------------------
# Test 4: validate fails for redundant artifact
# -------------------------------------------------------

$ awf flow new $FLOWS_DIR/validate-redundant --workflow feature
$ assert_stdout contains
| validate-redundant

$ write_file flows/validate-redundant/artifacts/stray.txt
| oops

$ awf flow validate --flow $FLOWS_DIR/validate-redundant
$ assert_exit_code 1
$ assert_stderr contains
| redundant artifact: stray.txt
