# Test: flow_run_resolves_command_from_repo_config
# A step referencing a command defined in repo config (not workflow) should resolve.

# --- Setup ---
$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]
|
| [commands]
| repo-true = "true"

$ write_file .agents/workflows/repo-cmd-test/WORKFLOW.toml
| name = "repo-cmd-test"
| version = 1
|
| [[stages]]
| name = "work"
| steps = [
|     { name = "true-step", type = "command", command = "repo-true" },
| ]

# --- Test steps ---

$ awf flow new --flow $FLOWS_DIR/repo-flow --workflow repo-cmd-test
$ assert_stdout
| repo-flow

$ awf flow run true-step --flow $FLOWS_DIR/repo-flow
$ assert_stdout
| PASS
