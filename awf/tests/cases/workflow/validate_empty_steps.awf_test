# Test: workflow validate rejects a stage with missing args fields

$ write_file .agents/workflows/empty-args/WORKFLOW.toml
| name = "empty-args"
| version = 1
|
| [[stages]]
| name = "work"
| kind = "command"
| args = { run = "true" }
|
| [[stages]]
| name = "done"
| kind = "command"
| args = {}

$ awf workflow validate empty-args
$ assert_exit_code 1
$ assert_stderr contains
| must set either
