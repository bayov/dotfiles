# Test: awf workflow validate
# Validates workflows: happy path, missing command key, missing prompt file.

# ---------------------------------------------------------------------------
# Setup: valid "feature" workflow with prompts and config
# ---------------------------------------------------------------------------

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a new feature from design through merge."
|
| [commands]
| test = "cargo test"
| lint = "cargo clippy -- -D warnings"
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| produces = ["design.md"]
| steps = [
|     { name = "write-design", type = "agent", prompt = "design.md" },
| ]
|
| [[stages]]
| name = "implement"
| description = "Write the code."
| requires = ["design.md"]
| steps = [
|     { name = "write-code", type = "agent", prompt = "implement.md" },
|     { name = "test", type = "command", command = "test" },
| ]
|
| [[stages]]
| name = "review"
| description = "Code review and integration."
| repeatable = true
| produces = ["changelog-entry.md"]
| steps = [
|     { name = "pre-review-test", type = "command", command = "test" },
|     { name = "do-review", type = "agent", prompt = "review.md" },
| ]
|
| [[stages]]
| name = "done"
| description = "Complete."

$ write_file .agents/workflows/feature/design.md
| # Design
| Write a design document.

$ write_file .agents/workflows/feature/implement.md
| # Implement
| Write the implementation.

$ write_file .agents/workflows/feature/review.md
| # Review
| Perform code review.

# ---------------------------------------------------------------------------
# Test 1: validate passes on a valid workflow
# ---------------------------------------------------------------------------

$ awf workflow validate feature
$ assert_stdout contains
| OK

# ---------------------------------------------------------------------------
# Test 2: validate reports missing command key
# ---------------------------------------------------------------------------

$ write_file .agents/workflows/bad/WORKFLOW.toml
| name = "bad"
| version = 1
|
| [[stages]]
| name = "do-stuff"
| steps = [
|     { name = "run-thing", type = "command", command = "undefined-key" },
| ]

$ awf workflow validate bad
$ assert_exit_code 1
$ assert_stderr contains
| undefined-key

# ---------------------------------------------------------------------------
# Test 3: validate reports missing prompt file
# ---------------------------------------------------------------------------

$ write_file .agents/workflows/noprompt/WORKFLOW.toml
| name = "noprompt"
| version = 1
|
| [[stages]]
| name = "ask"
| steps = [
|     { name = "think", type = "agent", prompt = "missing-prompt.md" },
| ]

$ awf workflow validate noprompt
$ assert_exit_code 1
$ assert_stderr contains
| missing-prompt.md
