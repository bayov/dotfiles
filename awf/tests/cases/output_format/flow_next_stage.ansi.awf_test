# Test: awf flow next-stage — output

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/minimal/WORKFLOW.toml
| name = "minimal"
| version = 1
|
| [[stages]]
| name = "work"
| kind = "command"
| args = { run = "true" }
|
| [[stages]]
| name = "done"
| kind = "command"
| args = { run = "true" }

$ export FORCE_COLOR=1

$ awf flow new $FLOWS_DIR/fmt-adv-h --workflow=minimal
$ assert_stdout contains
| fmt-adv-h

# Run the stage so advance is allowed

$ awf flow run --flow=$FLOWS_DIR/fmt-adv-h
$ assert_stdout equals
| [32mPASS[39m  true  (<...>)

$ awf flow next-stage --flow=$FLOWS_DIR/fmt-adv-h
$ assert_stdout equals
| [32m▶ Entered stage:[39m [35mdone[39m
| [90m  This is the final stage.[39m
|
| Next up (stage: [35mdone[39m):
|     - Run: `awf flow run --flow=[36m<...>/fmt-adv-h[39m`
