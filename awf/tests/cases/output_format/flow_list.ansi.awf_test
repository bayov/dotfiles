# Test: awf flow list — human and json output

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a feature."
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| steps = [
|     { name = "write-design", type = "agent", prompt = "design.md" },
| ]
|
| [[stages]]
| name = "done"
| description = "Complete."

$ write_file .agents/workflows/feature/design.md
| # Design

$ export FORCE_COLOR=1

# Create 5 flows: 2 active, 3 archived

$ awf flow new $FLOWS_DIR/alpha --workflow feature
$ assert_stdout contains
| alpha

$ awf flow new $FLOWS_DIR/bravo --workflow feature
$ assert_stdout contains
| bravo

$ awf flow new $FLOWS_DIR/charlie --workflow feature
$ assert_stdout contains
| charlie

$ awf flow new $FLOWS_DIR/delta --workflow feature
$ assert_stdout contains
| delta

$ awf flow new $FLOWS_DIR/echo --workflow feature
$ assert_stdout contains
| echo

$ awf flow archive --flow $FLOWS_DIR/charlie
$ assert_stdout contains
| charlie

$ awf flow archive --flow $FLOWS_DIR/delta
$ assert_stdout contains
| delta

$ awf flow archive --flow $FLOWS_DIR/echo
$ assert_stdout contains
| echo

# --- Human (active only) ---

$ awf flow list --output-format human
$ assert_stdout equals
| • [36m<...>/alpha[39m  (workflow: [34mfeature[39m, stage: [35mdesign[39m)
| • [36m<...>/bravo[39m  (workflow: [34mfeature[39m, stage: [35mdesign[39m)

# --- Human (all, including archived) ---

$ awf flow list --all --output-format human
$ assert_stdout equals
| • [36m<...>/alpha[39m  (workflow: [34mfeature[39m, stage: [35mdesign[39m)
| • [36m<...>/bravo[39m  (workflow: [34mfeature[39m, stage: [35mdesign[39m)
| • [36m<...>/charlie[39m  (workflow: [34mfeature[39m, stage: [35mdesign[39m, [90marchived[39m)
| • [36m<...>/delta[39m  (workflow: [34mfeature[39m, stage: [35mdesign[39m, [90marchived[39m)
| • [36m<...>/echo[39m  (workflow: [34mfeature[39m, stage: [35mdesign[39m, [90marchived[39m)

# --- JSON ---

$ awf flow list --output-format json
$ assert_stdout json
| {
|   "flows": [
|     {
|       "path": "<any_string>",
|       "workflow": "feature",
|       "stage": "design",
|       "archived": false
|     },
|     {
|       "path": "<any_string>",
|       "workflow": "feature",
|       "stage": "design",
|       "archived": false
|     }
|   ]
| }

$ awf flow list --all --output-format json
$ assert_stdout json
| {
|   "flows": [
|     {
|       "path": "<any_string>",
|       "workflow": "feature",
|       "stage": "design",
|       "archived": false
|     },
|     {
|       "path": "<any_string>",
|       "workflow": "feature",
|       "stage": "design",
|       "archived": false
|     },
|     {
|       "path": "<any_string>",
|       "workflow": "feature",
|       "stage": "design",
|       "archived": true
|     },
|     {
|       "path": "<any_string>",
|       "workflow": "feature",
|       "stage": "design",
|       "archived": true
|     },
|     {
|       "path": "<any_string>",
|       "workflow": "feature",
|       "stage": "design",
|       "archived": true
|     }
|   ]
| }
