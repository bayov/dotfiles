# Test: awf flow status — all status kinds and stage states

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

# Workflow with 5 stages to exercise all stage-state indicators
$ write_file .agents/workflows/multi/WORKFLOW.toml
| name = "multi"
| version = 1
|
| [[stages]]
| name = "done-step"
| description = "First step."
| kind = "agent"
| args = { prompt = "Do the first thing." }
|
| [[stages]]
| name = "forced-step"
| description = "Forced step."
| kind = "agent"
| args = { prompt = "Do the forced thing." }
|
| [[stages]]
| name = "skipped-step"
| description = "Skippable step."
| kind = "agent"
| args = { prompt = "Do the skippable thing." }
| skippable = true
|
| [[stages]]
| name = "current-step"
| description = "Current step."
| kind = "agent"
| args = { prompt = "Do the current thing." }
|
| [[stages]]
| name = "pending-step"
| description = "Pending step."
| kind = "agent"
| args = { prompt = "Do the pending thing." }
| skippable = true

# Simple 2-stage workflow for completed/archived scenarios
$ write_file .agents/workflows/simple/WORKFLOW.toml
| name = "simple"
| version = 1
|
| [[stages]]
| name = "step-one"
| description = "First step."
| kind = "agent"
| args = { prompt = "Do step one." }
|
| [[stages]]
| name = "step-two"
| description = "Second step."
| kind = "agent"
| args = { prompt = "Do step two." }

$ export FORCE_COLOR=1

# =============================================================================
# Active — single stage (just created)
# =============================================================================

$ awf flow new $FLOWS_DIR/fmt-status --workflow=simple
$ assert_stdout contains
| fmt-status

$ awf flow status --flow=$FLOWS_DIR/fmt-status
$ assert_stdout equals
|     Flow: [36m<...>/flows/fmt-status[39m
| Workflow: [34msimple[39m
|   Status: [34m[1mactive[0m[39m (stage: [35mstep-one[39m)
| 
| Workflow `[34msimple[39m` has 2 stages:
| [34m▶ [39m1. [35mstep-one[39m[34m (current)[39m
|     - First step.
|   2. [35mstep-two[39m
|     - Second step.
| 
| Next up (stage: [35mstep-one[39m):
|     - Instructions: Do step one.
|     - When done, proceed to the next stage with: `awf flow next-stage --flow=[36m<...>/flows/fmt-status[39m`

# =============================================================================
# Active — multiple stages at different states:
#   done-step:    completed
#   forced-step:  force-completed
#   skipped-step: skipped
#   current-step: current (active)
#   pending-step: pending (skippable)
# =============================================================================

$ awf flow new $FLOWS_DIR/multi-flow --workflow=multi
$ assert_stdout contains
| multi-flow

$ awf flow next-stage --flow=$FLOWS_DIR/multi-flow
$ assert_stdout contains
| forced-step

$ awf flow next-stage --force="no time" --flow=$FLOWS_DIR/multi-flow
$ assert_stdout contains
| skipped-step

$ awf flow next-stage --skip --flow=$FLOWS_DIR/multi-flow
$ assert_stdout contains
| current-step
$ assert_stderr contains
| Skipped stage

$ awf flow status --flow=$FLOWS_DIR/multi-flow
$ assert_stdout equals
|     Flow: [36m<...>/flows/multi-flow[39m
| Workflow: [34mmulti[39m
|   Status: [34m[1mactive[0m[39m (stage: [35mcurrent-step[39m)
| 
| Workflow `[34mmulti[39m` has 5 stages:
| [32m✓ [39m1. [35mdone-step[39m[32m (completed)[39m
|     - First step.
| [33m✓ [39m2. [35mforced-step[39m[33m (force-completed)[39m
|     - Forced step.
| [90m○ [39m3. [35mskipped-step[39m[90m (skipped)[39m
|     - Skippable step.
| [34m▶ [39m4. [35mcurrent-step[39m[34m (current)[39m
|     - Current step.
|   5. [35mpending-step[39m (skippable)
|     - Pending step.
| 
| Next up (stage: [35mcurrent-step[39m):
|     - Instructions: Do the current thing.
|     - When done, proceed to the next stage with: `awf flow next-stage --flow=[36m<...>/flows/multi-flow[39m`

# =============================================================================
# Completed — all stages done
# =============================================================================

$ awf flow new $FLOWS_DIR/done-flow --workflow=simple
$ assert_stdout contains
| done-flow

$ awf flow next-stage --flow=$FLOWS_DIR/done-flow
$ assert_stdout contains
| step-two

$ awf flow next-stage --flow=$FLOWS_DIR/done-flow
$ assert_stdout contains
| complete

$ awf flow status --flow=$FLOWS_DIR/done-flow
$ assert_stdout equals
|     Flow: [36m<...>/flows/done-flow[39m
| Workflow: [34msimple[39m
|   Status: [32m[1mcompleted[0m[39m
| 
| Workflow `[34msimple[39m` has 2 stages:
| [32m✓ [39m1. [35mstep-one[39m[32m (completed)[39m
|     - First step.
| [32m✓ [39m2. [35mstep-two[39m[32m (completed)[39m
|     - Second step.
| 
| Workflow complete. To archive this flow, run: `awf flow archive --flow=[36m<...>/flows/done-flow[39m`

# =============================================================================
# Archived
# =============================================================================

$ awf flow archive --flow=$FLOWS_DIR/done-flow
$ assert_stdout contains
| done-flow

$ awf flow status --flow=$FLOWS_DIR/done-flow
$ assert_stdout equals
|     Flow: [36m<...>/flows/done-flow[39m
| Workflow: [34msimple[39m
|   Status: [33m[1marchived[0m[39m (stage: [35mstep-two[39m)
| 
| Workflow `[34msimple[39m` has 2 stages:
| [32m✓ [39m1. [35mstep-one[39m[32m (completed)[39m
|     - First step.
| [32m✓ [39m2. [35mstep-two[39m[32m (completed)[39m
|     - Second step.
| 
| This flow is [33m[1marchived[0m[39m and cannot be modified. To re-activate the flow, run: `awf flow unarchive --flow=[36m<...>/flows/done-flow[39m`
