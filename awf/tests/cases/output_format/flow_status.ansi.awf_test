# Test: awf flow status — human and json output

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a feature."
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| kind = "agent"
| args = { prompt = "design.md" }

$ write_file .agents/workflows/feature/design.md
| # Design

$ awf flow new $FLOWS_DIR/fmt-status --workflow feature
$ assert_stdout contains
| fmt-status

# --- Human ---

$ export FORCE_COLOR=1

$ awf flow status --flow $FLOWS_DIR/fmt-status --output-format human
$ assert_stdout equals
|   flow: [36mfmt-status[39m
|  stage: [35mdesign[39m
| status: [32m[● active][39m

# --- JSON ---

$ awf flow status --flow $FLOWS_DIR/fmt-status --output-format json
$ assert_stdout json
| {
|   "flow": "fmt-status",
|   "stage": "design",
|   "status": "active"
| }
