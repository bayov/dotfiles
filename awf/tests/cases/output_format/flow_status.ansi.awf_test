# Test: awf flow status — output

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a feature."
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| kind = "agent"
| args = { prompt_file = "design.md" }

$ write_file .agents/workflows/feature/design.md
| # Design

$ awf flow new $FLOWS_DIR/fmt-status --workflow=feature
$ assert_stdout contains
| fmt-status

$ export FORCE_COLOR=1

$ awf flow status --flow=$FLOWS_DIR/fmt-status
$ assert_stdout equals
| Flow: [36m<...>/fmt-status[39m  (workflow: [34mfeature[39m, stage: [35mdesign[39m)
| Status: [32m[● active][39m
|
| Workflow `[34mfeature[39m` has 1 stages:
| [36m▶ [39m1. [35mdesign[39m (current)
|     - Produce a design doc.
|
| Next up (stage: [35mdesign[39m):
|     - Follow the instructions at: <...>/.agents/workflows/feature/design.md
|     - When done, proceed to the next stage with: `awf flow next-stage --flow=[36m<...>/fmt-status[39m`
