# Test: awf flow advance — human and json output
# Uses a minimal workflow (two stages, no steps) so advance works immediately.

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/minimal/WORKFLOW.toml
| name = "minimal"
| version = 1
|
| [[stages]]
| name = "work"
|
| [[stages]]
| name = "done"

# Separate flows (advance mutates state)

$ awf flow new $FLOWS_DIR/fmt-adv-h --workflow minimal
$ assert_stdout contains
| fmt-adv-h

$ awf flow new $FLOWS_DIR/fmt-adv-j --workflow minimal
$ assert_stdout contains
| fmt-adv-j

# --- Human ---

$ awf flow advance --flow $FLOWS_DIR/fmt-adv-h --output-format human
$ assert_stdout equals
| ▶ Entered stage: done
|   This is the final stage.

# --- JSON ---

$ awf flow advance --flow $FLOWS_DIR/fmt-adv-j --output-format json
$ assert_stdout json
| {
|   "stage": "done",
|   "is_final": true
| }
