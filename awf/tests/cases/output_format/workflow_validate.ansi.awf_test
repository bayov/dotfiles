# Test: awf workflow validate — human and json output

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a feature."
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| kind = "agent"
| args = { prompt = "design.md" }

$ write_file .agents/workflows/feature/design.md
| # Design

# --- Human ---

$ export FORCE_COLOR=1

$ awf workflow validate feature --output-format human
$ assert_stdout equals
| Workflow [34mfeature[39m: [32m✓ OK[39m

# --- JSON ---

$ awf workflow validate feature --output-format json
$ assert_stdout json
| {
|   "name": "feature",
|   "status": "ok"
| }
