# Test: awf flow done — output

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a feature."
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| kind = "agent"
| args = { prompt = "design.md" }

$ write_file .agents/workflows/feature/design.md
| # Design

$ export FORCE_COLOR=1

$ awf flow new $FLOWS_DIR/fmt-done-h --workflow=feature
$ assert_stdout contains
| fmt-done-h

$ awf flow next-stage --flow=$FLOWS_DIR/fmt-done-h
$ assert_stdout equals
| [32m✓[39m Stage [35mdesign[39m marked complete.
|
| Workflow complete. Use `awf flow archive --flow=[36m<...>/fmt-done-h[39m` to archive it.
