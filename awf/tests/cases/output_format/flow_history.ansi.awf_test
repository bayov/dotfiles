# Test: awf flow history — output
# Builds a multi-stage flow with a passing agent stage, a skipped agent stage, a failing
# command stage, a force-advance, and a passing command stage, then checks the final history.

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a feature."
|
| [commands]
| test = "true"
| lint = "false"
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| produces = ["design.md"]
| kind = "agent"
| args = { prompt_file = "design.md" }
|
| [[stages]]
| name = "write-code"
| description = "Write the code."
| kind = "agent"
| args = { prompt_file = "implement.md" }
|
| [[stages]]
| name = "optional-check"
| description = "Optional pre-lint sanity check."
| skippable = true
| kind = "agent"
| args = { prompt_file = "optional_check.md" }
|
| [[stages]]
| name = "lint"
| kind = "command"
| args = { command = "lint" }
|
| [[stages]]
| name = "test"
| kind = "command"
| args = { command = "test" }
|
| [[stages]]
| name = "do-review"
| description = "Final review."
| kind = "agent"
| args = { prompt_file = "review.md" }

$ write_file .agents/workflows/feature/design.md
| # Design

$ write_file .agents/workflows/feature/implement.md
| # Implement

$ write_file .agents/workflows/feature/optional_check.md
| # Optional Check

$ write_file .agents/workflows/feature/review.md
| # Review

# --- Build up flow state: design → write-code → optional-check (skip) → lint (fail, force) → test → do-review ---

$ export FORCE_COLOR=1

$ awf flow new $FLOWS_DIR/fmt-history --workflow=feature
$ assert_stdout contains
| fmt-history

# Complete design stage and advance
$ write_file flows/fmt-history/artifacts/design.md
| # Design doc
$ awf flow next-stage --flow=$FLOWS_DIR/fmt-history
$ assert_stdout contains
| write-code

# Complete write-code stage and advance
$ awf flow next-stage --flow=$FLOWS_DIR/fmt-history
$ assert_stdout contains
| optional-check

# Skip optional-check stage
$ awf flow next-stage --skip --flow=$FLOWS_DIR/fmt-history
$ assert_stdout contains
| lint
$ assert_stderr contains
| Skipped stage "optional-check"

# Run lint (fails)
$ awf flow run --flow=$FLOWS_DIR/fmt-history
$ assert_stdout contains
| FAIL

# Force advance past lint
$ awf flow next-stage --force="force moving to next stage despite lint failure" --flow=$FLOWS_DIR/fmt-history
$ assert_stdout contains
| test

# Run test (passes)
$ awf flow run --flow=$FLOWS_DIR/fmt-history
$ assert_stdout contains
| PASS
$ awf flow next-stage --flow=$FLOWS_DIR/fmt-history
$ assert_stdout contains
| do-review

# --- Check history output ---

$ awf flow history --flow=$FLOWS_DIR/fmt-history
$ assert_stdout equals
| [36m<...>/fmt-history[39m flow started at [90m<...>[39m
|     [32m✓[39m [32mdesign[39m completed at [90m<...>[39m
|     [32m✓[39m [32mwrite-code[39m completed at [90m<...>[39m
|     [33m○[39m [33moptional-check[39m skipped at [90m<...>[39m
|     [31m✗[39m [31mlint[39m failed at [90m<...>[39m
|     [33m⚠[39m [33mlint[39m force completed at [90m<...>[39m
|         [90mforce moving to next stage despite lint failure[39m
|     [32m✓[39m [32mtest[39m completed at [90m<...>[39m
