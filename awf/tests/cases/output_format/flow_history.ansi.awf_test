# Test: awf flow history — human and json output
# Builds a multi-stage flow with passing agent steps, a failing command step,
# and a passing command step, then checks the final history in both formats.

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a feature."
|
| [commands]
| test = "true"
| lint = "false"
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| produces = ["design.md"]
| steps = [
|     { name = "write-design", type = "agent", prompt = "design.md" },
| ]
|
| [[stages]]
| name = "implement"
| description = "Write the code."
| requires = ["design.md"]
| steps = [
|     { name = "write-code", type = "agent", prompt = "implement.md" },
|     { name = "lint", type = "command", command = "lint" },
|     { name = "test", type = "command", command = "test" },
| ]
|
| [[stages]]
| name = "done"
| description = "Complete."

$ write_file .agents/workflows/feature/design.md
| # Design

$ write_file .agents/workflows/feature/implement.md
| # Implement

# --- Build up flow state: design → implement → done ---

$ export FORCE_COLOR=1

$ awf flow new $FLOWS_DIR/fmt-history --workflow feature
$ assert_stdout contains
| fmt-history

$ awf flow step done write-design --flow $FLOWS_DIR/fmt-history
$ assert_stdout contains
| write-design
$ write_file flows/fmt-history/artifacts/design.md
| # Design doc
$ awf flow next-stage --flow $FLOWS_DIR/fmt-history
$ assert_stdout contains
| implement

$ awf flow step done write-code --flow $FLOWS_DIR/fmt-history
$ assert_stdout contains
| write-code
$ awf flow run lint --flow $FLOWS_DIR/fmt-history
$ assert_stdout contains
| FAIL
$ awf flow run test --flow $FLOWS_DIR/fmt-history
$ assert_stdout contains
| PASS
$ awf flow next-stage --force "force moving to next stage despite lint failure" --flow $FLOWS_DIR/fmt-history
$ assert_stdout contains
| done

# --- Human output ---
 
$ awf flow history --flow $FLOWS_DIR/fmt-history --output-format human
$ assert_stdout equals
| • stage [35mdesign[39m started at [90m<...>[39m
|     [32m✓[39m [32mwrite-design[39m step completed at [90m<...>[39m
|     [32m✓[39m stage completed at [90m<...>[39m
| • stage [35mimplement[39m started at [90m<...>[39m
|     [32m✓[39m [32mwrite-code[39m step completed at [90m<...>[39m
|     [31m✗[39m [31mlint[39m step failed at [90m<...>[39m
|     [32m✓[39m [32mtest[39m step completed at [90m<...>[39m
|     [33m⚠[39m stage [33mforce completed[39m at [90m<...>[39m
|         [33mforce moving to next stage despite lint failure[39m
| • stage [35mdone[39m started at [90m<...>[39m

# --- JSON output ---

$ awf flow history --flow $FLOWS_DIR/fmt-history --output-format json
$ assert_stdout json
| {
|   "entries": [
|     {
|       "stage": "design",
|       "started_at": "<any_string>",
|       "completed_at": "<any_string>",
|       "steps": [
|         {
|           "step": "write-design",
|           "status": "pass",
|           "step_type": "agent",
|           "completed_at": "<any_string>"
|         }
|       ]
|     },
|     {
|       "stage": "implement",
|       "started_at": "<any_string>",
|       "completed_at": "<any_string>",
|       "force_completed": true,
|       "force_reason": "force moving to next stage despite lint failure",
|       "steps": [
|         {
|           "step": "write-code",
|           "status": "pass",
|           "step_type": "agent",
|           "completed_at": "<any_string>"
|         },
|         {
|           "step": "lint",
|           "status": "fail",
|           "step_type": "command",
|           "completed_at": "<any_string>",
|           "duration_ms": "<any_number>"
|         },
|         {
|           "step": "test",
|           "status": "pass",
|           "step_type": "command",
|           "completed_at": "<any_string>",
|           "duration_ms": "<any_number>"
|         }
|       ]
|     },
|     {
|       "stage": "done",
|       "started_at": "<any_string>",
|       "steps": []
|     }
|   ]
| }
