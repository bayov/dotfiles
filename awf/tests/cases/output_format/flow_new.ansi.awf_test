# Test: awf flow new — output

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a feature."
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| kind = "agent"
| args = { prompt_file = "design.md" }

$ write_file .agents/workflows/feature/design.md
| # Design

$ export FORCE_COLOR=1

# =============================================================================
# Success
# =============================================================================

$ awf flow new $FLOWS_DIR/fmt-new-h --workflow=feature
$ assert_stdout equals
| Created `[34mfeature[39m` flow: [36m<...>/fmt-new-h[39m
|
| From now on, "active flow" refers to `[36m<...>/fmt-new-h[39m`.
|
| Workflow `[34mfeature[39m` has 1 stages:
| 1. [35mdesign[39m (current)
|     - Produce a design doc.
|
| Next up (stage: [35mdesign[39m):
|     - Follow the instructions at: <...>/.agents/workflows/feature/design.md
|     - When done, proceed to the next stage with: `awf flow next-stage --flow=[36m<...>/fmt-new-h[39m`

# =============================================================================
# Error: workflow not found
# =============================================================================

$ awf flow new $FLOWS_DIR/fmt-new-notfound --workflow=no-such-workflow
$ assert_exit_code 1
$ assert_stdout empty
$ assert_stderr equals
| [31merror:[39m workflow "no-such-workflow" not found
|
|   Searched in:
|     [36m[project][39m  <...>/.agents/workflows
|     [36m[user][39m  <...>/.agents/workflows
|
|   Available workflows:
|     [90mproject[39m:[36mfeature[39m

# =============================================================================
# Error: flow already exists
# =============================================================================

$ awf flow new $FLOWS_DIR/fmt-new-dup --workflow=feature
$ assert_stdout contains
| fmt-new-dup
$ awf flow new $FLOWS_DIR/fmt-new-dup --workflow=feature
$ assert_exit_code 1
$ assert_stdout empty
$ assert_stderr equals
| [31merror:[39m flow already exists at <...>/fmt-new-dup
