# Test: awf flow new — human and json output

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/feature/WORKFLOW.toml
| name = "feature"
| version = 1
| description = "Ship a feature."
|
| [[stages]]
| name = "design"
| description = "Produce a design doc."
| kind = "agent"
| args = { prompt = "design.md" }

$ write_file .agents/workflows/feature/design.md
| # Design

# --- Human ---

$ export FORCE_COLOR=1

$ awf flow new $FLOWS_DIR/fmt-new-h --workflow feature --output-format human
$ assert_stdout equals
| Created flow: [36m<...>/fmt-new-h[39m (workflow: [34mfeature[39m, stage: [35mdesign[39m)

# --- JSON ---

$ awf flow new $FLOWS_DIR/fmt-new-j --workflow feature --output-format json
$ assert_stdout json
| {
|   "path": "<any_string>",
|   "workflow": "feature",
|   "stage": "design"
| }
