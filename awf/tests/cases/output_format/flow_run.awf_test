# Test: awf flow run — human and json output

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "work"
| steps = [
|     { name = "pass-step", type = "command", run = "true" },
| ]

# Separate flows for each format (run mutates state)

$ awf flow new $FLOWS_DIR/fmt-run-h --workflow run-test
$ assert_stdout contains
| fmt-run-h

$ awf flow new $FLOWS_DIR/fmt-run-j --workflow run-test
$ assert_stdout contains
| fmt-run-j

# --- Human ---

$ awf flow run pass-step --flow $FLOWS_DIR/fmt-run-h --output-format human
$ assert_stdout equals
| PASS  true  (<...>ms)

# --- JSON ---

$ awf flow run pass-step --flow $FLOWS_DIR/fmt-run-j --output-format json
$ assert_stdout json
| {
|   "step": "pass-step",
|   "command": "true",
|   "status": "pass",
|   "duration_ms": "<any_number>"
| }
