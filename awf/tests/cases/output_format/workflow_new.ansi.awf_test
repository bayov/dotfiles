# Test: awf workflow new — human and json output

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

# --- Human ---

$ export CLICOLOR_FORCE=1

$ awf workflow new my-wf --output-format human
$ assert_stdout equals
| Created [1m.agents/workflows/my-wf/WORKFLOW.toml[0m
| Edit it to define your stages, then run `awf workflow validate [34mmy-wf[39m`.

# --- JSON ---

$ awf workflow new my-wf-j --output-format json
$ assert_stdout json
| {
|   "path": ".agents/workflows/my-wf-j/WORKFLOW.toml",
|   "name": "my-wf-j"
| }
