# Test: flow run fail then rerun reflects pass
# Runs a failing step, fixes the workflow so it passes, reruns, and checks status.

$ write_file .config/awf.toml
| flow_search_dirs = ["$FLOWS_DIR"]

$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "work"
| steps = [
|     { name = "pass-step", type = "command", run = "true" },
|     { name = "fail-step", type = "command", run = "false" },
| ]

# Step 1: Create flow
$ awf flow new $FLOWS_DIR/retry-flow --workflow run-test
$ assert_stdout
| retry-flow

# Step 2: Run fail-step (fails)
$ awf flow run fail-step --flow $FLOWS_DIR/retry-flow
$ assert_stdout
| FAIL

# Step 3: Rewrite WORKFLOW.toml so fail-step now passes
$ write_file .agents/workflows/run-test/WORKFLOW.toml
| name = "run-test"
| version = 1
|
| [[stages]]
| name = "work"
| steps = [
|     { name = "pass-step", type = "command", run = "true" },
|     { name = "fail-step", type = "command", run = "true" },
| ]

# Step 4: Run fail-step again (should now pass)
$ awf flow run fail-step --flow $FLOWS_DIR/retry-flow
$ assert_stdout
| PASS

# Step 5: Check status reflects pass
$ awf flow status --flow $FLOWS_DIR/retry-flow
$ assert_stdout
| pass
