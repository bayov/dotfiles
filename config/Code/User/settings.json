{
    //--------------------------------------------------------------------------
    // Usage
    //--------------------------------------------------------------------------
    "editor.formatOnSave": true,
    "files.autoSave": "onFocusChange",
    "window.enableMenuBarMnemonics": false, // Disable Alt key focusing the menu
    "window.customMenuBarAltFocus": false, // Disable Alt key focusing the menu
    //--------------------------------------------------------------------------
    // Files & Explorer
    //--------------------------------------------------------------------------
    "workbench.list.openMode": "doubleClick",
    "workbench.editor.revealIfOpen": true,
    "explorer.confirmDragAndDrop": false,
    "explorer.autoReveal": false,
    "explorer.decorations.badges": false, // Disable A/M/etc badges in explorer
    "explorer.excludeGitIgnore": true, // Hide .gitignore'ed files in explorer
    "workbench.tree.indent": 14,
    "workbench.tree.renderIndentGuides": "always",
    //--------------------------------------------------------------------------
    // Appearance
    //--------------------------------------------------------------------------
    "window.density.editorTabHeight": "compact",
    // By hiding commandCenter and layoutControl from top menu bar, entering
    // full-screen mode will completely hide the top-bar.
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    // Activity bar is toggleable (Alt+0), so this setting might change.
    "workbench.activityBar.location": "hidden",
    // Status bar is toggleable (Alt+-), so this setting might change.
    "workbench.statusBar.visible": false,
    "editor.minimap.enabled": false,
    "editor.rulers": [
        80
    ],
    "editor.scrollbar.horizontalScrollbarSize": 8,
    "editor.scrollbar.verticalScrollbarSize": 10,
    "editor.bracketPairColorization.enabled": false,
    // inlay hints
    "editor.inlayHints.padding": true,
    "editor.inlayHints.fontSize": 12,
    // color theme
    "workbench.colorTheme": "IntelliJ IDEA Islands Dark",
    "workbench.colorCustomizations": {
        // highlight of word under caret
        "editor.wordHighlightBackground": "#fff1",
        "editor.wordHighlightStrongBackground": "#fff1",
        // emphasis of where the word under caret is defined
        "editor.wordHighlightStrongBorder": "#fff6",
        // word being hovered (cursor / editor.action.showHover)
        "editor.hoverHighlightBackground": "#fff3",
        // highlight of text similar to current selection
        "editor.selectionHighlightBackground": "#fff2",
        "editor.selectionHighlightBorder": "#0000",
        // selections
        "editor.selectionBackground": "#26498f",
        // find matches (Ctrl+F)
        "editor.findMatchBackground": "#cc631340",
        "editor.findMatchBorder": "#ffb47aa1",
        "editor.findMatchHighlightBackground": "#cc631340",
        // tabs
        "tab.activeForeground": "#c8d6d5",
        "tab.activeBackground": "#2e3c58aa",
        "tab.unfocusedActiveForeground": "#c8d6d577",
        "tab.unfocusedActiveBackground": "#37393c66",
        "tab.hoverForeground": "#c8d6d5ff",
        "tab.hoverBackground": "#37393c66",
        // explorer file list
        "tree.inactiveIndentGuidesStroke": "#4d545f6c",
        "tree.indentGuidesStroke": "#7e92b370",
        "list.activeSelectionBackground": "#2e3c58aa",
        "list.focusBackground": "#37393caa",
        "list.inactiveSelectionBackground": "#2e3c58aa",
        "list.hoverBackground": "#37393c66",
        "list.warningForeground": "#D2B571",
        "gitDecoration.modifiedResourceForeground": "#6aa2d7",
        "jjDecoration.modifiedResourceForeground": "#6aa2d7",
        // inlay hints
        "editorInlayHint.foreground": "#96969666",
        "editorInlayHint.background": "#0000",
    },
    // syntax highlighting
    "editor.semanticTokenColorCustomizations": {
        "[IntelliJ IDEA Islands Dark]": {
            "rules": {
                // --- Global Modifiers ---
                // Force italics on mutable items
                "*.mutable": {
                    "italic": true
                },
                // Disable italics on mutable operators
                "operator.mutable": {
                    "italic": false
                },
                // --- Comments & Documentation ---
                // Standard comments (dimmed)
                "comment": "#686b71",
                // Doc comments
                "*.documentation": {
                    "foreground": "#74847a",
                    "italic": false
                },
                // --- Keywords & Control Flow ---
                "keyword": "#cf8e6d",
                // Rust `?` operator
                "operator.controlFlow": "#cf8e6d",
                // --- Strings & Formatting ---
                "string": "#6aab73",
                "escapeSequence": "#b8bd5a",
                // e.g. "{interpolated}"
                "formatSpecifier": "#bcbec4",
                // --- Modules & Attributes ---
                // Module paths/Crate roots
                "namespace": "#b2a897",
                "namespace.crateRoot": "#b2a897",
                // #[derive(...)] etc
                "*.attribute": "#b3ae60",
                // --- Functions & Methods ---
                // General functions
                "function": "#6aa2d7",
                "function:rust": "#6aa2d7",
                "function.declaration": "#6aa2d7",
                "function.declaration:rust": "#6aa2d7",
                "function.defaultLibrary": "#6aa2d7",
                "function.defaultLibrary:rust": "#6aa2d7",
                // Static functions (disable default italics)
                "function.static": {
                    "foreground": "#6aa2d7",
                    "italic": false
                },
                "function.static:rust": {
                    "foreground": "#6aa2d7",
                    "italic": false
                },
                // Methods
                "method": "#6aa2d7",
                "method:rust": "#6aa2d7",
                "method.declaration": "#6aa2d7",
                "method.declaration:rust": "#6aa2d7",
                "method.static": "#6aa2d7",
                "method.static:rust": "#6aa2d7",
                "method.defaultLibrary": "#6aa2d7",
                "method.defaultLibrary:rust": "#6aa2d7",
                // Treat rust macro calls as functions
                "macro:rust": "#6aa2d7",
                // --- Types (Structs, Enums) ---
                "type": "#86985d",
                "struct": "#86985d",
                "struct:rust": "#86985d",
                // Enums (disable default italics)
                "enum": {
                    "foreground": "#86985d",
                    "italic": false
                },
                "enum:rust": {
                    "foreground": "#86985d",
                    "italic": false
                },
                "enumMember": {
                    "foreground": "#86985d",
                    "italic": false
                },
                // --- Traits (Interfaces) ---
                "interface": "#9699d4",
                "interface:rust": "#9699d4",
                // --- Constants & Statics ---
                // Const (disable default italics)
                "const": {
                    "foreground": "#a482b7",
                    "italic": false
                },
                "const:rust": {
                    "foreground": "#a482b7",
                    "italic": false
                },
                "static": "#a482b7",
                "static:rust": "#a482b7",
                // --- Variables & Parameters ---
                "variable": "#bcbec4",
                "variable:rust": "#bcbec4",
                "property": "#bcbec4",
                "property:rust": "#bcbec4",
                "parameter": "#c79cb2",
                "parameter:rust": "#c79cb2",
                "selfKeyword": "#c79cb2",
                "selfKeyword:rust": "#c79cb2",
                // --- Generics ---
                "typeParameter": "#20999d",
                "typeParameter:rust": "#20999d",
                "constParameter": "#20999d",
                "constParameter:rust": "#20999d"
            }
        },
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                // I'd add `variable.other.metavariable.name.rust` here, but
                // it only colors macro_rules! metavariable name definition, not
                // usages, which ends up looking weird.
                "scope": "entity.name.function, entity.name.function.rust",
                "settings": {
                    "foreground": "#6aa2d7"
                }
            },
            {
                // I'd add `variable.other.metavariable.name.rust` here, but
                // it only colors macro_rules! metavariable name definition, not
                // usages, which ends up looking weird.
                "scope": "keyword.operator.macro.dollar.rust, variable.other.metavariable.specifier.rust",
                "settings": {
                    "foreground": "#c77dbb"
                }
            }
        ]
    },
    //--------------------------------------------------------------------------
    // Language-specific
    //--------------------------------------------------------------------------
    // Python
    "python.analysis.typeCheckingMode": "standard", // standard type checking rules
    // Rust
    "rust-analyzer.restartServerOnConfigChange": true,
    "rust-analyzer.testExplorer": true,
    "rust-analyzer.assist.emitMustUse": true,
    "rust-analyzer.assist.preferSelf": true,
    "rust-analyzer.references.excludeImports": true,
    "rust-analyzer.imports.granularity.group": "item", // match rustfmt
    "rust-analyzer.inlayHints.typeHints.enable": false,
    "rust-analyzer.inlayHints.parameterHints.enable": false,
    "rust-analyzer.inlayHints.genericParameterHints.const.enable": false,
    "rust-analyzer.inlayHints.closingBraceHints.minLines": 35,
    //--------------------------------------------------------------------------
    // Misc
    //--------------------------------------------------------------------------
    // Jujutsu VCS
    "jjk.enableAnnotations": false, // hide blame annotations on current line
    "git.enabled": false, // Hide Git changes (we use jj instead)
    // Remote dev (e.g., WSL)
    "remote.autoForwardPortsSource": "hybrid",
    // Dependi
    "dependi.decoration.compatible.template": "✓",
    "dependi.decoration.patchAvailable.template": "⇢ ${version}",
    //--------------------------------------------------------------------------
    // Uncategorized
    //  | VS Code appends new settings after the last setting so I'm keeping
    //  | `editor.columnSelection` intentionally under this comment block so
    //  | that all newly added settings are collected under it, allowing me to
    //  | review and categorize each new setting.
    //--------------------------------------------------------------------------
    "editor.columnSelection": false,
}