keybinds clear-defaults=true {   
    // Return to normal mode when pressing Enter or Ctrl+C
    shared_except "normal" "renamepane" "renametab" "entersearch" {
        bind "Enter" { SwitchToMode "normal"; }
        bind "Esc" { SwitchToMode "normal"; }
        bind "Ctrl c" { SwitchToMode "normal"; }
    }
    // Global keybinds
    shared_except "locked" {
        // Switch modes
        bind "Ctrl Alt f" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Alt c" { EditScrollback; SwitchToMode "normal"; }
        bind "Alt s" { SwitchToMode "pane"; }
        bind "Alt r" { SwitchToMode "resize"; }
        bind "Alt z" { Detach; }

        // General tools / windows / plugins
        bind "Alt /" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "Ctrl Alt w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "Alt ?" {
            LaunchOrFocusPlugin "zellij:about" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        // The configuration mode is pretty useless with custom keybinds
        // bind "Alt '" {
        //     LaunchOrFocusPlugin "configuration" {
        //         floating true
        //         move_to_focused_tab true
        //     }
        //     SwitchToMode "normal"
        // }
        
        // Copy & paste
        // Not working...
        // For now using `EditScrollback` mode and `copy_on_select true`.
        // bind "Ctrl c" { Copy; }
    
        // Scrolling & Scrollback
        bind "Alt up" { ScrollUp; ScrollUp; }
        bind "Alt down" { ScrollDown; ScrollDown; }
        bind "Alt PageUp" { HalfPageScrollUp; }
        bind "Alt PageDown" { HalfPageScrollDown; } 
        bind "Alt Home" { ScrollToTop; }
        bind "Alt End" { ScrollToBottom; }
        bind "Ctrl Alt l" { Clear; Write 12; }

        // Tab-management
        bind "f2" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "Alt t" { NewTab; }
        bind "Alt left" { GoToPreviousTab; }
        bind "Alt right" { GoToNextTab; }
        bind "Alt [" "Ctrl Alt left" { MoveTab "left"; }
        bind "Alt ]" "Ctrl Alt right" { MoveTab "right"; }
        // `Alt+s, x` to close tab

        // Pane-management
        bind "Alt s" { SwitchToMode "pane"; }
        bind "Alt Shift up" { MoveFocus "up"; }
        bind "Alt Shift down" { MoveFocus "down"; }
        bind "Alt Shift left" { MoveFocus "left"; }
        bind "Alt Shift right" { MoveFocus "right"; }
        bind "Alt {" { MovePane "left"; }
        bind "Alt }" { MovePane "right"; }
        // Resize using `Alt r` resize mode.
        bind "Alt x" { CloseFocus; }

        // Floating-panes
        bind "Alt q" { ToggleFloatingPanes; }
        bind "Alt Shift q" { NewPane; }
        bind "Alt p" { TogglePanePinned; }

        // Shift+Enter passthrough
        bind "Shift Enter" { Write 27 91 49 51 59 50 117; }

        // Misc
        bind "Ctrl Alt d" { DumpScreen "/tmp/zellij-scrollback.txt"; }
        // Omni-tool available?
        // Reload config available?
        // Debug overlay available?
        // URL handling not available?
    }
    locked {
        bind "Alt g" { SwitchToMode "normal"; }
    }
    entersearch {
        // Not using `search` mode at all, we simply stay in `entersearch` mode
        // and always able to edit the search string. Selecting occurences will
        // be done using Enter/Arrow keys.
        bind "Esc" { SwitchToMode "normal"; }
        bind "Ctrl c" { SwitchToMode "normal"; }
        bind "Ctrl f" { SwitchToMode "normal"; }
        bind "Ctrl Alt f" { SwitchToMode "normal"; }
        bind "Alt i" { SearchToggleOption "CaseSensitivity"; }
        bind "Alt u" { SearchToggleOption "WholeWord"; }
        bind "Alt y" { SearchToggleOption "Wrap"; }  // What is this?
        bind "Shift Enter" "Up" { Search "up"; }
        bind "Enter" "Down" { Search "down"; }
    }
    pane {
        bind "Alt s" { SwitchToMode "normal"; }
        bind "Alt left" { NewPane "left"; SwitchToMode "normal"; }
        bind "Alt down" { NewPane "down"; SwitchToMode "normal"; }
        bind "Alt up" { NewPane "up"; SwitchToMode "normal"; }
        bind "Alt right" { NewPane "right"; SwitchToMode "normal"; }
        // Rename
        bind "f2" { SwitchToMode "renamepane"; PaneNameInput 0; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "normal"; }
        bind "w" { TogglePaneEmbedOrFloating; }
        bind "x" { CloseTab; SwitchToMode "normal"; }
        // Focusing other panes
        bind "left" { MoveFocus "left"; }
        bind "down" { MoveFocus "down"; }
        bind "up" { MoveFocus "up"; }
        bind "right" { MoveFocus "right"; }
        // Moving panes
        bind "Shift left" { MovePane "left"; }
        bind "Shift down" { MovePane "down"; }
        bind "Shift up" { MovePane "up"; }
        bind "Shift right" { MovePane "right"; }
        // Increase size
        bind "8" { Resize "Increase up"; }
        bind "2" { Resize "Increase down"; }
        bind "4" { Resize "Increase left"; }
        bind "6" { Resize "Increase right"; }
        // Move panes between tabs
        bind "[" { BreakPaneLeft; }
        bind "]" { BreakPaneRight; }
    }
    renamepane {
        // Cancel
        bind "esc" { UndoRenamePane; SwitchToMode "pane"; }
        bind "f2" { UndoRenamePane; SwitchToMode "pane"; }
        bind "Ctrl c" { UndoRenamePane; SwitchToMode "pane"; }
        // Confirm
        bind "Enter" { SwitchToMode "normal"; }
    }
    renametab {
        // Cancel
        bind "esc" { UndoRenameTab; SwitchToMode "normal"; }
        bind "f2" { UndoRenameTab; SwitchToMode "normal"; }
        bind "Ctrl c" { UndoRenameTab; SwitchToMode "normal"; }
        // Confirm
        bind "Enter" { SwitchToMode "normal"; }
    }
    resize {
        bind "Alt r" { SwitchToMode "normal"; }
        // Increase size
        bind "up" { Resize "Increase up"; }
        bind "down" { Resize "Increase down"; }
        bind "left" { Resize "Increase left"; }
        bind "right" { Resize "Increase right"; }
        // Decrease size
        bind "Shift up" { Resize "Decrease up"; }
        bind "Shift down" { Resize "Decrease down"; }
        bind "Shift left" { Resize "Decrease left"; }
        bind "Shift right" { Resize "Decrease right"; }
    }
}

ui {
    pane_frames {
        // Hides the session name (randomly generated or otherwise) from the UI.
        hide_session_name false
    }
}

// Theme is embedded directly in this file rather than using `theme_dir` because
// Zellij does not expand `~` in `theme_dir` paths, making it unusable in a
// portable dotfiles setup. See: https://github.com/zellij-org/zellij/issues/4005
themes {
    bayov {
        // This component refers to the bare text parts of the Zellij UI (for
        // example, the Ctrl or Alt modifier indications in the status-bar).
        text_unselected {
            base "#ccc"
            background "#16161d"
            emphasis_0 "#d8a657"
            emphasis_1 "#c17fca"
            emphasis_2 "#7f95b8"
            emphasis_3 "#76946a"
        }
        // This component refers to the bare text parts of the Zellij UI when
        // they need to indicate selection (eg. when paging through search
        // results). This is often done by providing them a different color
        // background than their unselected counterparts.
        text_selected {
            base "#fff"
            background "#26498f"
            emphasis_0 "#d8a657"
            emphasis_1 "#c17fca"
            emphasis_2 "#7f95b8"
            emphasis_3 "#76946a"
        }
        // Ribbons are used often in the Zellij UI, examples are the tabs and
        // the keybinding modes in the status bar.
        ribbon_unselected {
            base "#aaacb2"
            background "#16161d"
            emphasis_0 "#d8a657"
            emphasis_1 "#16161d"  // some inactive tabs use this color
            emphasis_2 "#7f95b8"
            emphasis_3 "#76946a"
        }
        // Selected ribbons are often indicated with a different color than
        // their unselected counterparts (eg. the focused tab, or the active
        // keybinding mode in the status bar).
        ribbon_selected {
            base "#c8d6d5"
            background "#273143"
            emphasis_0 "#d8a657"
            emphasis_1 "#c17fca"
            emphasis_2 "#7f95b8"
            emphasis_3 "#76946a"
        }
        // The table UI component has a different style applied to its title
        // line than the rest of the table. This is what differentiates this
        // line.
        table_title {
            base "#fff"
            background "#333"
            emphasis_0 "#d8a657"
            emphasis_1 "#c17fca"
            emphasis_2 "#7f95b8"
            emphasis_3 "#76946a"
        }
        // The style of an unselected cell in a table. Cells can be specified as
        // selected or unselected individually, but it is often the case that a
        // full table line is specified to have selected or unselected cells.
        table_cell_unselected {
            base "#ccc"
            background "#f00"  // expected to be unused
            emphasis_0 "#d8a657"
            emphasis_1 "#c17fca"
            emphasis_2 "#7f95b8"
            emphasis_3 "#76946a"
        }
        // Often differentiated from its unselected counterpart by changing its
        // background color.
        table_cell_selected {
            base "#ccc"
            background "#333"
            emphasis_0 "#d8a657"
            emphasis_1 "#c17fca"
            emphasis_2 "#7f95b8"
            emphasis_3 "#76946a"
        }
        // A line item in a nested list, it can be arbitrarily indented. Its
        // indentation indication is not included in the item specification.
        list_unselected {
            base "#ccc"
            background "#f00"  // expected to be unused
            emphasis_0 "#d8a657"
            emphasis_1 "#c17fca"
            emphasis_2 "#7f95b8"
            emphasis_3 "#76946a"
        }
        // Often differentiated from its unselected counterpart with a different
        // background color.
        list_selected {
            base "#ccc"
            background "#333"
            emphasis_0 "#d8a657"
            emphasis_1 "#c17fca"
            emphasis_2 "#7f95b8"
            emphasis_3 "#76946a"
        }
        // The frame around the other non-focused panes.
        frame_unselected {
            base "#4c4c4c"
            background "#f00"  // expected to be unused
            emphasis_0 "#f00"  // expected to be unused
            emphasis_1 "#f00"  // expected to be unused
            emphasis_2 "#f00"  // expected to be unused
            emphasis_3 "#f00"  // expected to be unused
        }
        // The frame around the focused pane.
        frame_selected {
            base "#7e868f"
            background "#f00"  // expected to be unused
            emphasis_0 "#f00"  // expected to be unused
            emphasis_1 "#f00"  // expected to be unused
            emphasis_2 "#f00"  // expected to be unused
            emphasis_3 "#f00"  // expected to be unused
        }
        // This is the frame around the focused pane when the user enters a mode
        // other than the base mode (eg. PANE or TAB mode).
        frame_highlight {
            base "#d8a657"
            background "#f00"  // expected to be unused
            emphasis_0 "#f00"  // expected to be unused
            emphasis_1 "#f00"  // expected to be unused
            emphasis_2 "#f00"  // expected to be unused
            emphasis_3 "#f00"  // expected to be unused
        }
        // The color of the exit code indication (here, only the base part of
        // the specification is used, the rest are reserved for future use).
        // These can be seen in command panes (eg. when using zellij run) after
        // the command exited successfully.
        exit_code_success {
            base 118 148 106
            background 0
            emphasis_0 127 180 202
            emphasis_1 22 22 29
            emphasis_2 149 127 184
            emphasis_3 126 156 216
        }
        // The color of the exit code indication (here, only the base part of
        // the specification is used, the rest are reserved for future use).
        // These can be seen in command panes (eg. when using zellij run) after
        // the command exited with an error.
        exit_code_error {
            base 195 64 67
            background 0
            emphasis_0 255 158 59
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        // Each player represents the color given to a user joining (attaching)
        // to an active session. These colors appear the same to all users and
        // are given by order of attaching.
        multiplayer_user_colors {
            player_1 149 127 184
            player_2 126 156 216
            player_3 0
            player_4 255 158 59
            player_5 127 180 202
            player_6 0
            player_7 195 64 67
            player_8 0
            player_9 0
            player_10 0
        }
    }
}

// Plugin aliases - can be used to change the implementation of Zellij
// changing these requires a restart to take effect
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

// Plugins to load in the background when a new session starts
// eg. "file:/path/to/my-plugin.wasm"
// eg. "https://example.com/my-plugin.wasm"
load_plugins {
}
 
// Use a simplified UI without special fonts (arrow glyphs)
// Options:
//   - true
//   - false (Default)
// 
simplified_ui true
 
// Choose the theme that is specified in the themes section.
// Default: default
// 
// Note, theme file changes do not hot-reload, so touch config.kdl to force a
// reload
theme "bayov"
 
// Choose the base input mode of zellij.
// Default: normal
// 
default_mode "normal"
 
// Choose the path to the default shell that zellij will use for opening new panes
// Default: $SHELL
// 
// default_shell "fish"
 
// Choose the path to override cwd that zellij will use for opening new panes
// 
// default_cwd "/tmp"
 
// The name of the default layout to load on startup
// Default: "default"
// 
default_layout "compact"
 
// The folder in which Zellij will look for layouts
// (Requires restart)
// 
// layout_dir "/tmp"
 
// Toggle enabling the mouse mode.
// On certain configurations, or terminals this could
// potentially interfere with copying text.
// Options:
//   - true (default)
//   - false
// 
// mouse_mode false
 
// Toggle having pane frames around the panes
// Options:
//   - true (default, enabled)
//   - false
// 
pane_frames true
 
// When attaching to an existing session with other users,
// should the session be mirrored (true)
// or should each user have their own cursor (false)
// (Requires restart)
// Default: false
// 
// mirror_session true
 
// Choose what to do when zellij receives SIGTERM, SIGINT, SIGQUIT or SIGHUP
// eg. when terminal window with an active zellij session is closed
// (Requires restart)
// Options:
//   - detach (Default)
//   - quit
// 
// on_force_close "quit"
 
// Configure the scroll back buffer size
// This is the number of lines zellij stores for each pane in the scroll back
// buffer. Excess number of lines are discarded in a FIFO fashion.
// (Requires restart)
// Valid values: positive integers
// Default value: 10000
// 
scroll_buffer_size 100000
 
// Provide a command to execute when copying text. The text will be piped to
// the stdin of the program to perform the copy. This can be used with
// terminal emulators which do not support the OSC 52 ANSI control sequence
// that will be used by default if this option is not set.
// Examples:
//
// copy_command "xclip -selection clipboard" // x11
// copy_command "wl-copy"                    // wayland
// copy_command "pbcopy"                     // osx
// 
// copy_command "pbcopy"
 
// Choose the destination for copied text
// Allows using the primary selection buffer (on x11/wayland) instead of the system clipboard.
// Does not apply when using copy_command.
// Options:
//   - system (default)
//   - primary
// 
// copy_clipboard "primary"
 
// Enable automatic copying (and clearing) of selection when releasing mouse
// Default: true
// 
copy_on_select true
 
// Path to the default editor to use to edit pane scrollbuffer
// Default: $EDITOR or $VISUAL
//
// scrollback_editor "nvim"
 
// A fixed name to always give the Zellij session.
// Consider also setting `attach_to_session true,`
// otherwise this will error if such a session exists.
// Default: <RANDOM>
// 
// session_name "My singleton session"
 
// When `session_name` is provided, attaches to that session
// if it is already running or creates it otherwise.
// Default: false
// 
// attach_to_session true
 
// Toggle between having Zellij lay out panes according to a predefined set of layouts whenever possible
// Options:
//   - true (default)
//   - false
// 
// auto_layout false
 
// Whether sessions should be serialized to the cache folder (including their tabs/panes, cwds and running commands) so that they can later be resurrected
// Options:
//   - true (default)
//   - false
// 
// session_serialization false
 
// Whether pane viewports are serialized along with the session, default is false
// Options:
//   - true
//   - false (default)
// 
// serialize_pane_viewport false
 
// Scrollback lines to serialize along with the pane viewport when serializing sessions, 0
// defaults to the scrollback size. If this number is higher than the scrollback size, it will
// also default to the scrollback size. This does nothing if `serialize_pane_viewport` is not true.
// 
// scrollback_lines_to_serialize 10000
 
// Enable or disable the rendering of styled and colored underlines (undercurl).
// May need to be disabled for certain unsupported terminals
// (Requires restart)
// Default: true
// 
// styled_underlines false
 
// How often in seconds sessions are serialized
// 
// serialization_interval 10000
 
// Enable or disable writing of session metadata to disk (if disabled, other sessions might not know
// metadata info on this session)
// (Requires restart)
// Default: false
// 
// disable_session_metadata false
 
// Enable or disable support for the enhanced Kitty Keyboard Protocol (the host terminal must also support it)
// (Requires restart)
// Default: true (if the host terminal supports it)
// 
// support_kitty_keyboard_protocol false
 
// Whether to stack panes when resizing beyond a certain size
// Default: true
// 
// stacked_resize false
 
// Whether to show tips on startup
// Default: true
// 
show_startup_tips false
 
// Whether to show release notes on first version run
// Default: true
// 
// show_release_notes false

// Whether to enable mouse hover effects and multiple select functionality (pane grouping).
// Default: true
//
advanced_mouse_actions false
