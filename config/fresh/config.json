{
  "editor": {
    "rulers": [
      80
    ],
    "show_menu_bar": false,
    "show_tab_bar": false
  },
  "theme": "dark",
  "file_explorer": {
    "show_hidden": true
  },
  "file_browser": {
    "show_hidden": true
  },
  "keybindings": [
    {
      "key": "w",
      "modifiers": [
        "ctrl"
      ],
      "action": "expand_selection"
    },
    {
      "key": "a",
      "modifiers": [
        "alt"
      ],
      "action": "quick_open",
      "when": "global"
    },
    {
      "key": ";",
      "modifiers": [
        "alt"
      ],
      "action": "open_keybinding_editor"
    },
    {
      "key": "'",
      "modifiers": [
        "alt"
      ],
      "action": "open_settings"
    }
  ]
}