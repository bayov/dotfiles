{
  "editor": {
    "rulers": [
      80
    ],
    "show_menu_bar": false,
    "show_tab_bar": false,
    "show_status_bar": false
  },
  "theme": "dark",
  "file_explorer": {
    "show_hidden": true
  },
  "file_browser": {
    "show_hidden": true
  },
  "keybindings": [
    {
      "key": "w",
      "modifiers": [
        "ctrl"
      ],
      "action": "expand_selection"
    },
    {
      "key": "a",
      "modifiers": [
        "alt"
      ],
      "action": "quick_open",
      "when": "global"
    },
    {
      "key": ";",
      "modifiers": [
        "alt"
      ],
      "action": "open_keybinding_editor"
    },
    {
      "key": "'",
      "modifiers": [
        "alt"
      ],
      "action": "open_settings"
    },
    {
      "key": "1",
      "modifiers": [
        "alt"
      ],
      "action": "toggle_file_explorer",
      "when": "file_explorer"
    },
    {
      "key": "1",
      "modifiers": [
        "alt"
      ],
      "action": "noop",
      "when": "normal"
    },
    {
      "key": "F7",
      "modifiers": [
        "alt",
        "shift"
      ],
      "action": "noop",
      "when": "normal"
    },
    {
      "key": "1",
      "modifiers": [
        "alt"
      ],
      "action": "toggle_file_explorer",
      "when": "normal"
    },
    {
      "key": "-",
      "modifiers": [
        "alt"
      ],
      "action": "toggle_tab_bar"
    }
  ]
}