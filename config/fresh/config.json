{
  "version": 1,
  "theme": "dark",
  "editor": {
    "cursor_style": "blinking_bar",
    "show_menu_bar": false,
    "show_tab_bar": false,
    "show_status_bar": true,
    "rulers": [
      80
    ]
  },
  "file_explorer": {
    "show_hidden": true
  },
  "file_browser": {
    "show_hidden": true
  },
  "keybindings": [
    {
      "key": "w",
      "modifiers": [
        "ctrl"
      ],
      "action": "expand_selection"
    },
    {
      "key": "a",
      "modifiers": [
        "alt"
      ],
      "action": "quick_open",
      "when": "global"
    },
    {
      "key": ";",
      "modifiers": [
        "alt"
      ],
      "action": "open_keybinding_editor"
    },
    {
      "key": "'",
      "modifiers": [
        "alt"
      ],
      "action": "open_settings"
    },
    {
      "key": "1",
      "modifiers": [
        "alt"
      ],
      "action": "toggle_file_explorer",
      "when": "file_explorer"
    },
    {
      "key": "1",
      "modifiers": [
        "alt"
      ],
      "action": "noop",
      "when": "normal"
    },
    {
      "key": "F7",
      "modifiers": [
        "alt",
        "shift"
      ],
      "action": "noop",
      "when": "normal"
    },
    {
      "key": "1",
      "modifiers": [
        "alt"
      ],
      "action": "toggle_file_explorer",
      "when": "normal"
    },
    {
      "key": "-",
      "modifiers": [
        "alt"
      ],
      "action": "toggle_tab_bar"
    },
    {
      "key": "F7",
      "modifiers": [
        "alt",
        "shift"
      ],
      "action": "menu_open",
      "when": "global"
    },
    {
      "key": "v",
      "modifiers": [
        "ctrl",
        "alt"
      ],
      "action": "add_cursor_next_match",
      "when": "normal"
    },
    {
      "key": "F7",
      "modifiers": [
        "alt",
        "shift"
      ],
      "action": "add_cursor_next_match",
      "when": "normal"
    },
    {
      "key": "PageDown",
      "modifiers": [
        "ctrl",
        "alt"
      ],
      "action": "find_next",
      "when": "normal"
    },
    {
      "key": "PageUp",
      "modifiers": [
        "ctrl",
        "alt"
      ],
      "action": "find_previous",
      "when": "normal"
    }
  ]
}
