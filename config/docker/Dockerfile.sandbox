# Use Ubuntu 24.04 as the base for a general purpose environment.
FROM ubuntu:24.04

# Set environment variables.
ENV DOCKER_SANDBOX=1
ENV DEBIAN_FRONTEND=noninteractive

# Bootstrap: Install sudo.
RUN apt-get update && \
    apt-get install -y --no-install-recommends sudo && \
    rm -rf /var/lib/apt/lists/*

# Remove the default `ubuntu` user and create a non-root user named `sandbox`.
RUN userdel -r ubuntu && \
    groupadd -g 1000 sandbox && \
    useradd -u 1000 -g 1000 -m -s /usr/bin/bash sandbox && \
    echo "sandbox ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Switch to the non-root 'sandbox' user.
USER sandbox
WORKDIR /home/sandbox

# Copy and run installer scripts one by one to optimize cache.
COPY --chown=sandbox:sandbox scripts/install/sudo.sh scripts/install/

COPY --chown=sandbox:sandbox scripts/install/01_platform_specific.sh scripts/install/
RUN bash scripts/install/01_platform_specific.sh

COPY --chown=sandbox:sandbox scripts/install/02_pypi_packages.sh scripts/install/
RUN bash scripts/install/02_pypi_packages.sh

COPY --chown=sandbox:sandbox scripts/install/03_fish.sh scripts/install/
RUN bash scripts/install/03_fish.sh

COPY --chown=sandbox:sandbox scripts/install/04_fzf.sh scripts/install/
RUN bash scripts/install/04_fzf.sh

COPY --chown=sandbox:sandbox scripts/install/05_starship.sh scripts/install/
RUN bash scripts/install/05_starship.sh

COPY --chown=sandbox:sandbox scripts/install/06_rust.sh scripts/install/
RUN bash scripts/install/06_rust.sh

COPY --chown=sandbox:sandbox scripts/install/07_cargo_packages.sh scripts/install/
RUN bash scripts/install/07_cargo_packages.sh

COPY --chown=sandbox:sandbox scripts/install/08_nodejs.sh scripts/install/
RUN bash scripts/install/08_nodejs.sh

COPY --chown=sandbox:sandbox scripts/install/09_npm_packages.sh scripts/install/
RUN bash scripts/install/09_npm_packages.sh

COPY --chown=sandbox:sandbox scripts/install/10_gum.sh scripts/install/
RUN bash scripts/install/10_gum.sh

COPY --chown=sandbox:sandbox scripts/install/11_claude_code.sh scripts/install/
RUN bash scripts/install/11_claude_code.sh

# Default command is fish.
ENV SHELL="/usr/bin/fish"
CMD ["/usr/bin/fish"]
