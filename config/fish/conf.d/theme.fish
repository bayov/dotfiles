# Main syntax
set --global fish_color_normal normal
set --global fish_color_command blue
set --global fish_color_operator yellow
set --global fish_color_comment brblack
set --global fish_color_quote 6aab73
set --global fish_color_escape b8bd5a
set --global fish_color_redirection 9699d4

# Parameters
set --global fish_color_param normal
set --global fish_color_option c79cb2
set --global fish_color_valid_path b2a897 --underline=single

# "Keywords"
set --global fish_color_end cf8e6d
set --global fish_color_keyword cf8e6d

# Misc
set --global fish_color_error red
set --global fish_color_autosuggestion 666666

# Pager (options)
set --global fish_pager_color_completion brblack
set --global fish_pager_color_prefix brblack --underline=single
set --global fish_pager_color_background
set --global fish_pager_color_description B3A06D


# Pager (selected)
set --global fish_pager_color_selected_completion normal
set --global fish_pager_color_selected_prefix normal --underline=single
set --global fish_pager_color_selected_background --background=333333
set --global fish_pager_color_selected_description B3A06D

# Pager (seconday)
set --global fish_pager_color_secondary_background 
set --global fish_pager_color_secondary_completion 
set --global fish_pager_color_secondary_description 
set --global fish_pager_color_secondary_prefix 

set --global fish_pager_color_progress brwhite --bold --background=cyan

# Unknown (unused?)
set --global fish_color_cancel --reverse
set --global fish_color_history_current --bold
set --global fish_color_match F28779
set --global fish_color_search_match --bold --background=FFCC66
set --global fish_color_selection --bold --background=FFCC66

