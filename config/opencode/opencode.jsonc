{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth@latest"],
  "theme": "opencode",
  "keybinds": {
    "leader": "ctrl+x",
    "app_exit": "ctrl+d",
    // window management
    "command_list": "alt+a",
    "sidebar_toggle": "ctrl+b",
    "status_view": "ctrl+g",
    // scrolling
    "messages_page_up": "pageup",
    "messages_page_down": "pagedown",
    "messages_line_up": "alt+up",
    "messages_line_down": "alt+down",
    "messages_previous": "ctrl+alt+up",
    "messages_next": "ctrl+alt+down",
    "messages_first": "alt+home",
    "messages_last": "alt+end",
    // input
    "input_select_word_forward": "ctrl+shift+right",
    "input_select_word_backward": "ctrl+shift+left",
    "input_delete": "delete,shift+delete",
    // misc
    "tool_details": "<leader>v"
  }
}
