#!/usr/bin/env python3
"""
Generates a commit description interactively using AI.

Uses `generate_commit_description` to get the description, and shows a spinner
box while waiting.

If a description already exists for the current commit, prompts the user to
confirm if they want to override it before generating a new one.

Finally, uses `jj describe` to set the generated description for the current commit.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

LATEST = Path("/tmp/generate-commit-description/latest.md")
SELF = os.path.abspath(__file__)


def run(cmd, **kwargs):
    return subprocess.run(cmd, **kwargs)


def generate() -> None:
    result = run(
        ["generate_commit_description"], capture_output=True, text=True
    )

    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        sys.stderr.write("generate_commit_description: invalid output\n")
        sys.exit(1)

    if error := data.get("error"):
        sys.stderr.write(f"{error}\n")
        sys.exit(1)

    description = data.get("commit_description", "").strip()
    if not description:
        sys.stderr.write("generate_commit_description: empty description\n")
        sys.exit(1)

    LATEST.parent.mkdir(parents=True, exist_ok=True)
    LATEST.write_text(description)
    print(description)


def main() -> None:
    r = run(["fish", "-c", "precommit"])
    if r.returncode != 0:
        sys.exit(r.returncode)

    r = run(
        ["jj", "log", "-r", "@", "-n", "1", "--no-graph", "-T", "description"],
        capture_output=True,
        text=True,
    )
    current_desc = r.stdout.strip()

    if current_desc:
        run(
            [
                "echo_box",
                f"--content={current_desc}",
                "--title=Existing Commit Description",
                "--title-fg=3",
                "--margin-bottom=0",
            ]
        )
        r = run(
            [
                "gum",
                "confirm",
                "Override description?",
                "--prompt.foreground=3",
                "--selected.background=3",
                "--padding=0 1",
            ]
        )
        if r.returncode != 0:
            sys.exit(r.returncode)

    r = run(
        [
            "spinner",
            "--box",
            "--box-title",
            "Commit Description",
            "--title",
            "generating",
            "--",
            "python3",
            SELF,
            "--generate",
        ]
    )
    if r.returncode != 0:
        sys.exit(r.returncode)

    description = LATEST.read_text().strip()
    if not description:
        sys.stderr.write("Empty commit description\n")
        sys.exit(1)

    run(["jj", "describe", "-m", description, "--quiet"])


if __name__ == "__main__":
    if "--generate" in sys.argv:
        generate()
    else:
        main()
